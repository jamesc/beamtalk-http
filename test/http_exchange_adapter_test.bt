/// Edge cases for the Buccaneer adapter that the shared server suite
/// does not hit: mapping details (duplicate headers, query shapes,
/// chunked and 100-continue bodies, non-UTF-8 bodies), failure paths
/// (raise, non-response, over-large body) and server plumbing (router
/// dispatch, actor handlers, `#bind`).
TestCase subclass: HttpExchangeAdapterTest
  field: srv = nil

  tearDown =>
    self.srv isNil ifFalse: [self.srv stop]
    self.srv := nil

  startBuccaneer: handler => HTTPServer start: 0 handler: handler

  startBuccaneer: handler options: extra =>
    HTTPServer
      start: 0
      handler: handler
      options: extra

  baseUrl => "http://localhost:" ++ self.srv port asString

  /// Send `raw` on a fresh connection and read until `last` shows up.
  pipelined: raw :: String until: last :: String -> String =>
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: self.srv port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: raw
    got := ""
    [(got includesSubstring: last) not]
      whileTrue: [
        got := got
          concat: (((Erlang gen_tcp)
            recv: client
            with: 0
            with: 2000) unwrap) asStringUnchecked
      ]
    (Erlang gen_tcp) close: client
    got

  // BT-4466: a body the handler never reads is drained before the next
  // keep-alive request, so its bytes cannot be parsed as that request.
  testIgnoredBodyDoesNotLeakIntoNextRequest =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "at " ++ req path}
    ]
    raw := self pipelined: "POST /a HTTP/1.1\r\nhost: x\r\ncontent-length: 18\r\n\r\nGET /evil HTTP/1.1GET /b HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n" until: "at /b"
    self assert: (raw includesSubstring: "at /a")
    self assert: (raw includesSubstring: "at /b")
    self deny: (raw includesSubstring: "/evil")

  testIgnoredChunkedBodyDoesNotLeakIntoNextRequest =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "at " ++ req path}
    ]
    raw := self pipelined: "POST /a HTTP/1.1\r\nhost: x\r\ntransfer-encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\nGET /b HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n" until: "at /b"
    self assert: (raw includesSubstring: "at /a")
    self assert: (raw includesSubstring: "at /b")
    self deny: (raw includesSubstring: "400")

  testDuplicateHeadersKeptSeparate =>
    self.srv := self
      startBuccaneer: [:req |
        wanted := req headers select: [:pair | (pair at: 1) =:= "x-foo"]
        HTTPResponse new: #{
          #status => 200,
          #body => (wanted collect: [:pair | pair at: 2]) join: ","
        }
      ]
    resp := (HTTPClient
      request: #get
      url: self baseUrl ++ "/dup"
      options: #{#headers => #(#("x-foo", "1"), #("x-foo", "2"))}) unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "1,2"

  testHeadHasNoBody =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "hi"}
    ]
    resp := (HTTPClient
      request: #head
      url: self baseUrl ++ "/"
      options: #{}) unwrap
    self assert: resp status equals: 200
    self assert: (resp body asStringUnchecked) equals: ""

  testChunkedRequestBody =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse new: #{
          #status => 200,
          #body => "got:" ++ req body asStringUnchecked
        }
      ]
    raw := self
      rawPost: self.srv port
      path: "/chunked"
      headers: "transfer-encoding: chunked\r\n"
      body: "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
    self assert: (raw includesSubstring: "200 OK")
    self assert: (raw includesSubstring: "got:hello world")

  test100Continue =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse new: #{
          #status => 200,
          #body => "got:" ++ req body asStringUnchecked
        }
      ]
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "POST /echo100 HTTP/1.1\r\nhost: x\r\ncontent-length: 5\r\nexpect: 100-continue\r\nconnection: close\r\n\r\n"
    interim := (Erlang gen_tcp)
      recv: client
      with: 0
      with: 500
    interim isError ifFalse: [
      self assert: (interim value asStringUnchecked startsWith: "HTTP/1.1 100")
    ]
    (Erlang gen_tcp) send: client with: "hello"
    final := ((Erlang gen_tcp)
      recv: client
      with: 0
      with: 3000) unwrap
    (Erlang gen_tcp) close: client
    self assert: (final asStringUnchecked includesSubstring: "200 OK")
    self assert: (final asStringUnchecked includesSubstring: "got:hello")

  testFlagQueryParam =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          new: #{
            #status => 200,
            #body => (req queryParams at: "q") ++ "," ++ (req queryParams at: "flag")
          }
      ]
    resp := (HTTPClient get: self baseUrl ++ "/search?q=x&flag") unwrap
    self assert: resp body equals: "x,true"

  testEncodedQueryParam =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse new: #{#status => 200, #body => req queryParams at: "name"}
      ]
    resp := (HTTPClient get: self baseUrl ++ "/?name=%41%42+%43") unwrap
    self assert: resp body equals: "AB C"

  testLowercaseHexQueryParam =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse new: #{#status => 200, #body => req queryParams at: "name"}
      ]
    resp := (HTTPClient get: self baseUrl ++ "/?name=%2f%41") unwrap
    self assert: resp body equals: "/A"

  testMalformedQueryBecomes400 =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "unreached"}
    ]
    badHex := (HTTPClient get: self baseUrl ++ "/?name=%zz") unwrap
    self assert: badHex status equals: 400
    trailing := (HTTPClient get: self baseUrl ++ "/?name=%") unwrap
    self assert: trailing status equals: 400

  testEmptyQuerySegmentsSkipped =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          new: #{#status => 200, #body => (req queryParams at: "a")
              ++ ","
              ++ (req queryParams at: "b")
              ++ ","
              ++ (req queryParams at: "" ifAbsent: ["absent"])}
      ]
    resp := (HTTPClient get: self baseUrl ++ "/?a=1&&b=2&") unwrap
    self assert: resp body equals: "1,2,absent"

  testMalformedChunkedBodyBecomes400 =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "unreached"}
    ]
    raw := self
      rawPost: self.srv port
      path: "/bad"
      headers: "transfer-encoding: chunked\r\n"
      body: "ZZZ\r\nhello\r\n0\r\n\r\n"
    self assert: (raw includesSubstring: "400")

  testBodyLimitBoundary =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "got it"}
    ]
    exact := (HTTPClient post: self baseUrl ++ "/" body: ("x" repeat: 8000000)) unwrap
    self assert: exact status equals: 200
    over := (HTTPClient post: self baseUrl ++ "/" body: ("x" repeat: 8000001)) unwrap
    self assert: over status equals: 413

  // BT-4500: `bodyValue:` validates once and keeps `asString` behaviour.
  testBodyValueEmptyIsEmptyString =>
    v := HttpExchangeAdapter bodyValue: (Binary fromBytes: #())
    self assert: (v isKindOf: String)
    self assert: v equals: ""

  testBodyValueAsciiIsString =>
    v := HttpExchangeAdapter bodyValue: (Binary fromBytes: #(104, 105))
    self assert: (v isKindOf: String)
    self assert: v equals: "hi"

  testBodyValueMultibyteUtf8IsString =>
    // "é" is C3 A9.
    v := HttpExchangeAdapter bodyValue: (Binary fromBytes: #(195, 169))
    self assert: (v isKindOf: String)
    self assert: v size equals: 1

  testBodyValueInvalidUtf8StaysBinary =>
    data := Binary fromBytes: #(255, 254)
    v := HttpExchangeAdapter bodyValue: data
    self deny: (v isKindOf: String)
    self assert: v size equals: 2

  testBodyValueTruncatedSequenceStaysBinary =>
    // "a" then the first byte of a two-byte sequence.
    v := HttpExchangeAdapter bodyValue: (Binary fromBytes: #(97, 195))
    self deny: (v isKindOf: String)
    self assert: v size equals: 2

  testBodyValueSurrogateStaysBinary =>
    // CESU-style encoded surrogate U+D800 (ED A0 80) is not UTF-8.
    v := HttpExchangeAdapter bodyValue: (Binary fromBytes: #(237, 160, 128))
    self deny: (v isKindOf: String)

  testBodyValueLargeValidBodyIsString =>
    v := HttpExchangeAdapter bodyValue: (Binary fromBytes: ((1 to: 65536) collect: [:i |
      120
    ]))
    self assert: (v isKindOf: String)
    self assert: v size equals: 65536

  testBodyValueStringPassesThrough =>
    self assert: (HttpExchangeAdapter bodyValue: "abc") equals: "abc"

  // BT-4500: the post-handler drain is skipped for a body already read to
  // its end, and kept for everything else.
  testBodyCompleteTrueSkipsDrain =>
    self assert: (HttpExchangeAdapter bodyComplete: (BodyCompleteStub complete: true))

  testBodyCompleteFalseKeepsDrain =>
    self deny: (HttpExchangeAdapter bodyComplete: (BodyCompleteStub complete: false))

  testBodyCompleteFalseWhenExchangeLacksIt =>
    // An older Buccaneer has no `bodyComplete`: fall back to draining.
    self deny: (HttpExchangeAdapter bodyComplete: 42)

  testReadBodyHandlerKeepAliveStaysFramed =>
    // Two POSTs on one connection; the handler reads each body, so the
    // adapter skips the drain. The second request must still parse.
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse new: #{
          #status => 200,
          #body => "echo:" ++ req body asStringUnchecked
        }
      ]
    raw := self pipelined: "POST /a HTTP/1.1\r\nhost: x\r\ncontent-length: 3\r\n\r\nabcPOST /b HTTP/1.1\r\nhost: x\r\ncontent-length: 3\r\nconnection: close\r\n\r\nxyz" until: "echo:xyz"
    self assert: (raw includesSubstring: "echo:abc")
    self assert: (raw includesSubstring: "echo:xyz")
    self deny: (raw includesSubstring: "400")

  testPartlyReadBodyIsStillDrained =>
    // The handler reads one chunk and stops: the rest is drained, so it
    // cannot be parsed as the next request.
    self.srv := self
      startBuccaneer: [:req |
        req readChunk
        HTTPResponse new: #{#status => 200, #body => "at " ++ req path}
      ]
    raw := self pipelined: "POST /a HTTP/1.1\r\nhost: x\r\ncontent-length: 18\r\n\r\nGET /evil HTTP/1.1GET /b HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n" until: "at /b"
    self assert: (raw includesSubstring: "at /a")
    self assert: (raw includesSubstring: "at /b")
    self deny: (raw includesSubstring: "/evil")

  testLargeEchoRoundTrips =>
    // A 64 KiB echo through a block handler.
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => req body}
    ]
    resp := (HTTPClient post: self baseUrl ++ "/" body: ("y" repeat: 65536)) unwrap
    self assert: resp body size equals: 65536

  testInvalidUtf8BodyIsBinaryInBlockHandler =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          new: #{
            #status => 200,
            #body => ((req body isKindOf: String) ifTrue: [
              "string"
            ] ifFalse: ["binary"])
          }
      ]
    raw := self
      rawPost: self.srv port
      path: "/bin"
      headers: "content-length: 2\r\n"
      body: (Binary fromBytes: #(255, 254))
    self assert: (raw includesSubstring: "binary")

  testEmptyBodyIsEmptyStringInBlockHandler =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          new: #{
            #status => 200,
            #body => ((req body isKindOf: String) ifTrue: [
              "string:" ++ req body size asString
            ] ifFalse: ["binary"])
          }
      ]
    resp := (HTTPClient post: self baseUrl ++ "/" body: "") unwrap
    self assert: resp body equals: "string:0"

  testValidUtf8EchoRoundTrips =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => req body}
    ]
    resp := (HTTPClient post: self baseUrl ++ "/" body: "héllo wörld") unwrap
    self assert: resp body equals: "héllo wörld"

  testNonUtf8BodyStaysBinary =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          new: #{
            #status => 200,
            #body => ((req body isKindOf: Binary) ifTrue: [
              "binary"
            ] ifFalse: ["string"])
          }
      ]
    raw := self
      rawPost: self.srv port
      path: "/bin"
      headers: "content-length: 2\r\n"
      body: (Binary fromBytes: #(255, 254))
    self assert: (raw includesSubstring: "binary")

  testRaiseBecomes500 =>
    self.srv := self startBuccaneer: [:req | Error signal: "boom"]
    resp := (HTTPClient get: self baseUrl ++ "/") unwrap
    self assert: resp status equals: 500

  testBodyTooLargePrefixRaiseBecomes500 =>
    self.srv := self startBuccaneer: [:req |
      Error signal: "body_too_large: not really"
    ]
    resp := (HTTPClient get: self baseUrl ++ "/") unwrap
    self assert: resp status equals: 500

  testNonResponseBecomes500 =>
    self.srv := self startBuccaneer: [:req |
      (req path =:= "/nil") ifTrue: [nil] ifFalse: ["nope"]
    ]
    stringResp := (HTTPClient get: self baseUrl ++ "/string") unwrap
    self assert: stringResp status equals: 500
    nilResp := (HTTPClient get: self baseUrl ++ "/nil") unwrap
    self assert: nilResp status equals: 500

  testBodyTooLargeBecomes413 =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "unreached"}
    ]
    big := "x" repeat: 9 * 1024 * 1024
    resp := (HTTPClient post: self baseUrl ++ "/" body: big) unwrap
    self assert: resp status equals: 413

  testActorHandler =>
    self.srv := self startBuccaneer: EchoActor spawn
    resp := (HTTPClient post: self baseUrl ++ "/" body: "hi") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "POST"

  testRouterDispatch =>
    router := HTTPRouter
      routes: #(HTTPRoute
        get: "/users/:id"
        handler: [:req |
          HTTPResponse new: #{
            #status => 200,
            #body => "user:" ++ (req params at: "id")
          }
        ])
    self.srv := self startBuccaneer: router
    okResp := (HTTPClient get: self baseUrl ++ "/users/42") unwrap
    self assert: okResp body equals: "user:42"
    missingResp := (HTTPClient get: self baseUrl ++ "/missing") unwrap
    self assert: missingResp status equals: 404
    methodResp := (HTTPClient post: self baseUrl ++ "/users/42" body: "") unwrap
    self assert: methodResp status equals: 405

  testBindOption =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "bound"}
    ] options: #{#bind => "127.0.0.1"}
    resp := (HTTPClient get: self baseUrl ++ "/") unwrap
    self assert: resp body equals: "bound"

  testPortInUseRaises =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    used := self.srv port
    clash := Result
      tryDo: [
        HTTPServer start: used handler: [:req |
          HTTPResponse new: #{#status => 200, #body => "no"}
        ]
      ]
    self assert: clash isError

  testParseBind =>
    v4 := HttpExchangeAdapter parseBind: "127.0.0.1"
    self assert: (v4 at: 1) equals: {127, 0, 0, 1}
    self assert: (v4 at: 2) equals: false
    v6 := HttpExchangeAdapter parseBind: "::1"
    self assert: (v6 at: 1) equals: {0, 0, 0, 0, 0, 0, 0, 1}
    self assert: (v6 at: 2) equals: true
    full := HttpExchangeAdapter parseBind: "1:2:3:4:5:6:7:8"
    self assert: (full at: 1) equals: {1, 2, 3, 4, 5, 6, 7, 8}
    mapped := HttpExchangeAdapter parseBind: "::ffff:1.2.3.4"
    self assert: (mapped at: 1) equals: {0, 0, 0, 0, 0, 65535, 258, 772}
    zeros := HttpExchangeAdapter parseBind: "::"
    self assert: (zeros at: 1) equals: {0, 0, 0, 0, 0, 0, 0, 0}
    // OTP edge parity (BT-4324): uppercase hex, embedded v4, leading
    // zeros, and zone suffixes parse; empty, triple colons, and
    // padded input raise. Note the zone delta: the old manual parser
    // rejected zones, while inet:parse_address (like cowboy) accepts
    // them and answers the bare address.
    upper := HttpExchangeAdapter parseBind: "FE80::1"
    self assert: (upper at: 1) equals: {65152, 0, 0, 0, 0, 0, 0, 1}
    self assert: (upper at: 2) equals: true
    tail := HttpExchangeAdapter parseBind: "::1.2.3.4"
    self assert: (tail at: 1) equals: {0, 0, 0, 0, 0, 0, 258, 772}
    padded := HttpExchangeAdapter parseBind: "001.002.003.004"
    self assert: (padded at: 1) equals: {1, 2, 3, 4}
    self assert: (padded at: 2) equals: false
    zoned := HttpExchangeAdapter parseBind: "fe80::1%eth0"
    self assert: (zoned at: 1) equals: {65152, 0, 0, 0, 0, 0, 0, 1}
    self assert: (zoned at: 2) equals: true
    bad := #("1.2.3.4.5", "1::2::3", "gggg::1", "1:2:3:4:5:6:7::8", "12345::", "not-an-ip", "", "1:::2", "127.0.0.1 ")
    bad
      do: [:each |
        self assert: (Result tryDo: [
          HttpExchangeAdapter parseBind: each
        ]) isError
      ]

  testBindIpv6 =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "v6"}
    ] options: #{#bind => "::1"}
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {0, 0, 0, 0, 0, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false}, #inet6)) unwrap
    (Erlang gen_tcp) send: client with: "GET / HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n"
    raw := ((Erlang gen_tcp)
      recv: client
      with: 0
      with: 3000) unwrap
    (Erlang gen_tcp) close: client
    self assert: (raw asStringUnchecked includesSubstring: "v6")

  testInvalidBindRaises =>
    outcome := Result
      tryDo: [
        HTTPServer
          start: 0
          handler: [:req | nil]
          options: #{#bind => "not-an-ip"}
      ]
    self assert: outcome isError

  testInvalidHandlerRaises =>
    garbage := Result tryDo: [self startBuccaneer: "oops"]
    self assert: garbage isError
    nilHandler := Result tryDo: [self startBuccaneer: nil]
    self assert: nilHandler isError

  testNibbleBounds =>
    self assert: (QueryParser nibble: "0") equals: 0
    self assert: (QueryParser nibble: "9") equals: 9
    self assert: (QueryParser nibble: "a") equals: 10
    self assert: (QueryParser nibble: "f") equals: 15
    self assert: (QueryParser nibble: "A") equals: 10
    self assert: (QueryParser nibble: "F") equals: 15
    self assert: (QueryParser nibble: "g") isNil

  testParseQueryDirect =>
    q := QueryParser parse: "a=1&b=&flag"
    self assert: (q at: "a") equals: "1"
    self assert: (q at: "b") equals: ""
    self assert: (q at: "flag") equals: "true"
    self assert: (QueryParser parse: "") equals: #{}
    self assert: (QueryParser parse: nil) equals: #{}
    adjacent := QueryParser parse: "n=%41%42"
    self assert: (adjacent at: "n") equals: "AB"
    mixed := QueryParser parse: "n=%41+%42C+%2f"
    self assert: (mixed at: "n") equals: "A BC /"

  testRequestHeadersConversion =>
    strings := HttpExchangeAdapter requestHeaders: #({"host", "a"}, {"x", "b"})
    self assert: strings equals: #(#("host", "a"), #("x", "b"))
    valid := HttpExchangeAdapter requestHeaders: #({"x", Binary fromBytes: #(104, 105)})
    self assert: valid equals: #(#("x", "hi"))
    self assert: (HttpExchangeAdapter requestHeaders: #({"x", Binary fromBytes: #(255, 254)})) isNil
    self assert: (HttpExchangeAdapter requestHeaders: #({"x", 7})) isNil

  testClientDisconnectKeepsServing =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => "alive"}
    ]
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "POST /gone HTTP/1.1\r\nhost: x\r\ncontent-length: 100\r\nconnection: close\r\n\r\npartial"
    (Erlang gen_tcp) close: client
    resp := (HTTPClient get: self baseUrl ++ "/") unwrap
    self assert: resp body equals: "alive"

  testStreamValueCarriesBlock =>
    r := HTTPResponse streamWith: [:resp | resp finish]
    self assert: r stream notNil
    self assert: r file isNil

  testFileValues =>
    whole := (HTTPResponse file: "test/fixtures/stream_file") withStatus: 200
    self assert: whole status equals: 200
    self assert: whole fileOffset equals: 0
    self assert: whole fileLength equals: #all
    part := HTTPResponse
      file: "test/fixtures/stream_file"
      offset: 4
      length: 6
    self assert: part file equals: "test/fixtures/stream_file"
    self assert: part fileOffset equals: 4
    self assert: part fileLength equals: 6

  testReadChunkWithoutExchangeIsNotSupported =>
    req := HTTPRequest new: #{#method => "GET", #path => "/"}
    self assert: req readChunk equals: (Result error: #not_supported)
    self assert: (req inform: 103 headers: #()) equals: (Result error: #not_supported)
    self assert: req body equals: ""

  testStreamWithBlock =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp startChunked: 200 headers: #(#("content-type", "text/plain"))
            (resp sendChunk: "part1") unwrap
            (resp sendChunk: "part2") unwrap
            resp finish
          ]
      ]
    resp := (HTTPClient get: self baseUrl ++ "/stream") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "part1part2"

  testStreamWithRouter =>
    router := HTTPRouter
      routes: #(HTTPRoute
        get: "/s"
        handler: [:req |
          HTTPResponse
            streamWith: [:resp |
              resp startChunked: 200 headers: #()
              (resp sendChunk: "routed") unwrap
              resp finish
            ]
        ])
    self.srv := self startBuccaneer: router
    resp := (HTTPClient get: self baseUrl ++ "/s") unwrap
    self assert: resp body equals: "routed"

  testStreamWithActorPullsChunks =>
    self.srv := self startBuccaneer: (ChunkFeed spawnWith: #{
      #rows => #("r1", "r2", "r3")
    })
    resp := (HTTPClient get: self baseUrl ++ "/feed") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "r1r2r3"

  testStreamUnfinishedIsFinishedByAdapter =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp startChunked: 200 headers: #()
            (resp sendChunk: "half") unwrap
            "no-finish"
          ]
      ]
    resp := (HTTPClient get: self baseUrl ++ "/half") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "half"

  testStreamUnstartedBecomes500 =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse streamWith: [:resp | "never-started"]
    ]
    resp := (HTTPClient get: self baseUrl ++ "/unstarted") unwrap
    self assert: resp status equals: 500

  testStreamDoubleStartCloses =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp startChunked: 200 headers: #()
            resp startChunked: 200 headers: #()
            resp finish
          ]
      ]
    raw := self rawGet: self.srv port path: "/double"
    self assert: (raw startsWith: "HTTP/1.1 200")
    self deny: (raw includesSubstring: "0\r\n\r\n")

  testStreamChunkBeforeStartBecomes500 =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp sendChunk: "early"
            resp finish
          ]
      ]
    resp := (HTTPClient get: self baseUrl ++ "/early") unwrap
    self assert: resp status equals: 500

  testFileMissingBecomes500 =>
    self.srv := self startBuccaneer: [:req |
      (HTTPResponse file: "test/fixtures/does-not-exist") withStatus: 200
    ]
    resp := (HTTPClient get: self baseUrl ++ "/missing-file") unwrap
    self assert: resp status equals: 500

  testStreamRaiseAfterHeadersCloses =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp startChunked: 200 headers: #()
            (resp sendChunk: "part") unwrap
            Error signal: "boom-after-headers"
            resp finish
          ]
      ]
    raw := self rawGet: self.srv port path: "/boom"
    self assert: (raw startsWith: "HTTP/1.1 200")
    self deny: (raw includesSubstring: "0\r\n\r\n")

  testReadChunkStreamsBody =>
    self.srv := self
      startBuccaneer: [:req |
        total := 0
        done := false
        [done]
          whileFalse: [
            chunk := (req readChunk) unwrap
            chunk isEmpty ifTrue: [
              done := true
            ] ifFalse: [total := total + chunk size]
          ]
        HTTPResponse new: #{#status => 200, #body => total printString}
      ]
    resp := (HTTPClient post: self baseUrl ++ "/chunks" body: "hello world") unwrap
    self assert: resp body equals: "11"

  testBodyReadsRestAfterReadChunk =>
    self.srv := self
      startBuccaneer: [:req |
        first := (req readChunk) unwrap
        rest := req body
        HTTPResponse new: #{
          #status => 200,
          #body => (first size + rest size) printString
        }
      ]
    big := "y" repeat: 9000000
    resp := (HTTPClient post: self baseUrl ++ "/rest" body: big) unwrap
    self assert: resp body equals: "9000000"

  testBodyOverLimitReads413 =>
    self.srv := self startBuccaneer: [:req |
      HTTPResponse new: #{#status => 200, #body => req body}
    ]
    big := "z" repeat: 9000000
    resp := (HTTPClient post: self baseUrl ++ "/big" body: big) unwrap
    self assert: resp status equals: 413

  testPlugPreservesExchangeForInform =>
    inner := [:req |
      outcome := req inform: 103 headers: #()
      HTTPResponse new: #{
        #status => 200,
        #body => (outcome isOk ifTrue: ["live"] ifFalse: ["dead"])
      }
    ]
    composed := PlugChain chain: #((TaggingPlug tag: "A")) handler: inner
    self.srv := self startBuccaneer: composed
    resp := (HTTPClient get: self baseUrl ++ "/") unwrap
    self assert: resp status equals: 200
    // The in-tag stays in the request body (this handler never reads it);
    // "live" proves the exchange survived the plug, "[A-out]" the wrap.
    self assert: resp body equals: "live[A-out]"

  testReadChunkFromActorRaisesNotOwner =>
    self.srv := self startBuccaneer: ReadChunkProbe spawn
    resp := (HTTPClient get: self baseUrl ++ "/") unwrap
    self assert: resp status equals: 200
    self assert: (resp body asStringUnchecked startsWith: "caught:not_owner:")

  testInformSends103 =>
    self.srv := self
      startBuccaneer: [:req |
        outcome := req inform: 103 headers: #(#("link", "</app.css>; rel=preload"))
        outcome isOk ifFalse: [Error signal: "inform failed"]
        HTTPResponse new: #{#status => 200, #body => "final"}
      ]
    raw := self rawGet: self.srv port path: "/early"
    self assert: (raw includesSubstring: "HTTP/1.1 103")
    self assert: (raw includesSubstring: "link: </app.css>")
    self assert: (raw includesSubstring: "200 OK")
    self assert: (raw endsWith: "final")

  testInformRefusedOnHttp10 =>
    self.srv := self
      startBuccaneer: [:req |
        outcome := req inform: 103 headers: #()
        HTTPResponse
          new: #{
            #status => 200,
            #body => ((outcome error =:= #not_supported) ifTrue: [
              "unsupported"
            ] ifFalse: ["other"])
          }
      ]
    raw := self rawHttp10: self.srv port path: "/"
    self assert: (raw includesSubstring: "unsupported")

  testFileWhole =>
    self.srv := self
      startBuccaneer: [:req |
        ((HTTPResponse file: "test/fixtures/stream_file") withStatus: 200) withHeaders: #(#("content-type", "text/plain"))
      ]
    resp := (HTTPClient get: self baseUrl ++ "/file") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "0123456789abcdef"

  testFileOffsetLength =>
    self.srv := self
      startBuccaneer: [:req |
        ((HTTPResponse
          file: "test/fixtures/stream_file"
          offset: 4
          length: 6) withStatus: 200) withHeaders: #(#("content-type", "text/plain"))
      ]
    resp := (HTTPClient get: self baseUrl ++ "/part") unwrap
    self assert: resp body equals: "456789"

  testFileFromActor =>
    self.srv := self startBuccaneer: FileActor spawn
    resp := (HTTPClient get: self baseUrl ++ "/actor-file") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "0123456789abcdef"

  testUploadOneGibStreamsInBoundedMemory =>
    self.srv := self
      startBuccaneer: [:req |
        total := 0
        done := false
        [done]
          whileFalse: [
            chunk := (req readChunk) unwrap
            chunk isEmpty ifTrue: [
              done := true
            ] ifFalse: [total := total + chunk size]
          ]
        HTTPResponse new: #{#status => 200, #body => total printString}
      ]
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "POST /upload HTTP/1.1\r\nhost: x\r\ncontent-length: 1073741824\r\nconnection: close\r\n\r\n"
    piece := "x" repeat: 1048576
    i := 0
    [i < 1024]
      whileTrue: [
        ((Erlang gen_tcp) send: client with: piece) unwrap
        i := i + 1
      ]
    raw := self recvAll: client
    (Erlang gen_tcp) close: client
    self assert: (raw includesSubstring: "200 OK")
    self assert: (raw includesSubstring: "1073741824")

  testDownloadOneGibStreamsInBoundedMemory =>
    self.srv := self
      startBuccaneer: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp startChunked: 200 headers: #(#("content-length", "1073741824"))
            i := 0
            piece := "a" repeat: 1048576
            [i < 1024]
              whileTrue: [
                (resp sendChunk: piece) unwrap
                i := i + 1
              ]
            resp finish
          ]
      ]
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "GET /download HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n"
    head := ""
    [(head asStringUnchecked includesSubstring: "\r\n\r\n") not]
      whileTrue: [
        head := head
          concat: (((Erlang gen_tcp)
            recv: client
            with: 1
            with: 10000) unwrap)
      ]
    self assert: ((head asStringUnchecked) includesSubstring: "content-length: 1073741824")
    total := 0
    i := 0
    [i < 1024]
      whileTrue: [
        got := ((Erlang gen_tcp)
          recv: client
          with: 1048576
          with: 10000) unwrap
        total := total + got size
        i := i + 1
      ]
    (Erlang gen_tcp) close: client
    self assert: total equals: 1073741824

  rawGet: port path: path =>
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "GET " ++ path ++ " HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n"
    raw := self recvAll: client
    (Erlang gen_tcp) close: client
    raw

  rawHttp10: port path: path =>
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "GET " ++ path ++ " HTTP/1.0\r\nhost: x\r\nconnection: close\r\n\r\n"
    raw := self recvAll: client
    (Erlang gen_tcp) close: client
    raw

  recvAll: client =>
    out := ""
    done := false
    [done]
      whileFalse: [
        got := (Erlang gen_tcp)
          recv: client
          with: 0
          with: 5000
        got isError ifTrue: [
          done := true
        ] ifFalse: [out := out concat: got value]
      ]
    out asStringUnchecked

  rawPost: port path: path headers: headerLines body: body =>
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp)
      send: client
      with: "POST "
        ++ path
        ++ " HTTP/1.1\r\nhost: x\r\n"
        ++ headerLines
        ++ "connection: close\r\n\r\n"
    (Erlang gen_tcp) send: client with: body
    raw := ((Erlang gen_tcp)
      recv: client
      with: 0
      with: 3000) unwrap
    (Erlang gen_tcp) close: client
    raw asStringUnchecked
