/// Test fixture: tags the request body on the way in and the response body
/// on the way out with its own name, so a chain of several TaggingPlugs
/// lets a single response body prove both the call order (outermost-first
/// going in) and the reverse unwind order (outermost-last going out)
/// without any shared mutable state between plugs.
Value subclass: TaggingPlug
  field: tag :: String = ""

  class tag: t :: String -> TaggingPlug => self new: #{#tag => t}

  call: request :: HTTPRequest next: next :: Block(HTTPRequest, HTTPResponse) -> HTTPResponse =>
    // A withBody: copy keeps every other field — notably #exchange, so
    // body streaming still works downstream, and route #params.
    tagged := request withBody: request body asStringUnchecked ++ "[" ++ self.tag ++ "-in]"
    response := next value: tagged
    // A withBody: copy likewise keeps #stream / #file, so streaming and
    // sendfile responses pass through untouched apart from the tag.
    response withBody: response body asStringUnchecked ++ "[" ++ self.tag ++ "-out]"
