/// Test fixture: a plug that never calls `next` — short-circuits every request.
Value subclass: BlockingPlug

  call: _request :: HTTPRequest next: _next :: Block(HTTPRequest, HTTPResponse) -> HTTPResponse =>
    HTTPResponse new: #{#status => 403, #body => "blocked"}
