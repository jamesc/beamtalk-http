/// Test `WebSocketHandler`: echoes text and binary frames through the
/// handle, answers "info" to anything else, and records its close
/// reason in the `#wsUpgradeEvents` ETS table when one exists.
sealed typed Value subclass: WsEchoHandler
  field: opened :: Boolean = false
  field: texts :: Integer = 0

  class onOpen: _ws :: WebSocketHandle request: _req :: HTTPRequest -> WsEchoHandler =>
    self new withOpened: true

  onText: text :: String ws: ws :: WebSocketHandle -> WsEchoHandler =>
    ws sendText: text
    self withTexts: self texts + 1

  onBinary: data :: Binary ws: ws :: WebSocketHandle -> WsEchoHandler =>
    ws sendBinary: data
    self

  onInfo: _message :: Object ws: ws :: WebSocketHandle -> WsEchoHandler =>
    ws sendText: "info"
    self

  onClose: reason :: Object -> Object =>
    (Ets exists: #wsUpgradeEvents) ifTrue: [
      (Ets named: #wsUpgradeEvents) at: #close put: reason
    ]
    {#closed, reason}
