/// Test actor: answers the raw request bytes as "size:sum", proving
/// `HTTPRequest bodyBytes` works off the connection process, where the
/// whole body was already read before dispatch.
Actor subclass: BodyBytesActor

  handle: req :: HTTPRequest -> HTTPResponse =>
    bytes := req bodyBytes
    // Count the byte list: a String-tagged Binary's `size` is graphemes.
    list := bytes toBytes
    sum := list inject: 0 into: [:a :b | a + b]
    HTTPResponse new: #{
      #status => 200,
      #body => list size asString ++ ":" ++ sum asString
    }
