// BT-4530: bench-smoke for the gun-vs-mint comparison. These tests assert
// only success (smoke) and print wall-clock timings via Transcript; run the
// same file against the gun backend (main) and the mint backend (this
// branch) and compare the printed numbers. Kept small enough to stay in
// the default CI run.

TestCase subclass: BenchSmokeTest
  field: baseUrl = ""
  field: server = nil

  // Start the local test server and record the base URL.
  setUp =>
    self.server := HTTPTestServer start
    self.baseUrl := "http://localhost:" ++ self.server port asString
    self

  // Stop the local test server after each test.
  tearDown => self.server isNil ifFalse: [self.server stop]

  elapsedMs: t0 :: Integer -> Integer =>
    ((Erlang erlang) monotonic_time: #millisecond) - t0

  // Fresh connection per request: connect + request + close cost.
  testBenchOneShotGet =>
    n := 50
    t0 := (Erlang erlang) monotonic_time: #millisecond
    n timesRepeat: [
      resp := (HTTPClient get: self.baseUrl ++ "/get") unwrap
      self assert: resp status equals: 200
    ]
    dt := self elapsedMs: t0
    result := (Erlang file) write_file: "/tmp/bench-oneshot-get.txt" with: ("one-shot GET: {n} reqs in {dt}ms" toBytes)
    self assert: result isOk

  // One persistent client: keep-alive reuse on a single connection.
  testBenchPersistentGet =>
    n := 100
    client := HTTPClient spawnWith: #{#baseUrl => self.baseUrl}
    t0 := (Erlang erlang) monotonic_time: #millisecond
    n timesRepeat: [
      resp := (client get: "/get") unwrap
      self assert: resp status equals: 200
    ]
    dt := self elapsedMs: t0
    self assert: client stop equals: #ok
    result := (Erlang file) write_file: "/tmp/bench-persistent-get.txt" with: ("persistent GET: {n} reqs in {dt}ms" toBytes)
    self assert: result isOk

  // One-shot POST with a small body: upload path parity.
  testBenchOneShotPost =>
    n := 25
    t0 := (Erlang erlang) monotonic_time: #millisecond
    n timesRepeat: [
      resp := (HTTPClient post: self.baseUrl ++ "/post" body: "payload") unwrap
      self assert: resp status equals: 200
    ]
    dt := self elapsedMs: t0
    result := (Erlang file) write_file: "/tmp/bench-oneshot-post.txt" with: ("one-shot POST: {n} reqs in {dt}ms" toBytes)
    self assert: result isOk
