// BT-1338: BUnit integration tests for HTTPServer.
//
// Tests cover:
//   - Start/stop lifecycle
//   - Ephemeral port assignment
//   - Start-time validation (handler, port, bind, removed cowboy backend)
//   - Request handling with block handlers
//   - HTTPRequest fields (method, path, body) and their String class
//   - Response status codes
//   - printString
//
// BT-4087 folded the cowboy server's EUnit suite
// (native/test/beamtalk_http_server_tests.erl) in here.

TestCase subclass: HTTPServerTest
  field: srv = nil

  tearDown => self.srv isNil ifFalse: [self.srv stop]

  // ===== Lifecycle =====
  testStartAndStop =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    self assert: self.srv port > 0
    self.srv stop
    self.srv := nil

  testEphemeralPort =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    self assert: self.srv port > 0
    self assert: self.srv port <= 65535

  testStartAnswersLiveActor =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    self assert: self.srv isAlive

  testStopClosesListener =>
    srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    port := srv port
    srv stop
    refused := (Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#active, #false})
    self assert: refused isError

  testTwoServersGetDistinctPorts =>
    handler := [:req | HTTPResponse new: #{#status => 200, #body => "ok"}]
    self.srv := HTTPServer start: 0 handler: handler
    other := HTTPServer start: 0 handler: handler
    otherPort := other port
    other stop
    self deny: self.srv port =:= otherPort

  // ===== Start-time validation =====
  testInvalidHandlerRaisesTypeError =>
    self should: [HTTPServer start: 0 handler: #notAHandler] raise: #type_error

  testNegativePortRaises =>
    outcome := Result
      tryDo: [
        HTTPServer start: -1 handler: [:req |
          HTTPResponse new: #{#status => 200, #body => "ok"}
        ]
      ]
    self assert: outcome isError

  testNonStringBindRaises =>
    outcome := Result
      tryDo: [
        HTTPServer
          start: 0
          handler: [:req | HTTPResponse new: #{#status => 200, #body => "ok"}]
          options: #{#bind => 123}
      ]
    self assert: outcome isError

  testStopIsIdempotent =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    self.srv stop
    self.srv := nil

  // ===== Request handling =====
  testGetRequest =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "hello"}
    ]
    url := "http://localhost:" ++ self.srv port asString ++ "/test"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "hello"

  testPostRequestWithBody =>
    self.srv := HTTPServer
      start: 0
      handler: [:req |
        body := req body
        HTTPResponse new: #{
          #status => 200,
          #body => "echo: " ++ body asStringUnchecked
        }
      ]
    url := "http://localhost:" ++ self.srv port asString ++ "/echo"
    resp := (HTTPClient post: url body: "test data") unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "echo: test data"

  testHandlerReceivesMethod =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => req method}
    ]
    url := "http://localhost:" ++ self.srv port asString ++ "/method"
    resp := (HTTPClient get: url) unwrap
    self assert: resp body equals: "GET"

  testHandlerReceivesPath =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => req path}
    ]
    url := "http://localhost:" ++ self.srv port asString ++ "/hello/world"
    resp := (HTTPClient get: url) unwrap
    self assert: resp body equals: "/hello/world"

  // BT-4171: request text fields answer String (validated at the
  // boundary). The handler checks the classes where they arrive and
  // answers what it found.
  testRequestTextFieldsAreStrings =>
    self.srv := HTTPServer
      start: 0
      handler: [:req |
        pairs := req headers
        headersOk := pairs isEmpty not
          and: [
            pairs allSatisfy: [:pair |
              ((pair at: 1) isKindOf: String) and: [
                (pair at: 2) isKindOf: String
              ]
            ]
          ]
        query := req queryParams
        queryOk := (query at: "name") =:= "Ada"
          and: [
            (query keys allSatisfy: [:k |
              k isKindOf: String
            ]) and: [query values allSatisfy: [:v | v isKindOf: String]]
          ]
        found := #((req method isKindOf: String), (req path isKindOf: String), (req body isKindOf: String), queryOk, headersOk)
        HTTPResponse new: #{#status => 200, #body => found printString}
      ]
    url := "http://127.0.0.1:" ++ self.srv port asString ++ "/hello?name=Ada"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: #(true, true, true, true, true) printString

  testRequestBodyArrivesAsString =>
    self.srv := HTTPServer
      start: 0
      handler: [:req |
        body := req body
        HTTPResponse new: #{
          #status => 200,
          #body => (body isKindOf: String) printString ++ ":" ++ body
        }
      ]
    url := "http://127.0.0.1:" ++ self.srv port asString ++ "/echo"
    resp := (HTTPClient post: url body: "test data") unwrap
    self assert: resp body equals: "true:test data"

  testRouteParamsAreStrings =>
    router := HTTPRouter
      routes: #(HTTPRoute
        get: "/users/:id"
        handler: [:req |
          params := req params
          allText := params keys allSatisfy: [:k | k isKindOf: String]
          allText := allText and: [
            params values allSatisfy: [:v | v isKindOf: String]
          ]
          HTTPResponse new: #{
            #status => 200,
            #body => allText printString ++ ":" ++ (req param: "id")
          }
        ])
    self.srv := HTTPServer start: 0 handler: router
    url := "http://127.0.0.1:" ++ self.srv port asString ++ "/users/42"
    resp := (HTTPClient get: url) unwrap
    self assert: resp body equals: "true:42"

  // %FF percent-decodes to <<255>>, which is not valid UTF-8: the
  // boundary answers 400 and the handler never runs.
  testInvalidUtf8QueryValueAnswers400 =>
    (Ets exists: #httpServerTestHits) ifTrue: [
      (Ets named: #httpServerTestHits) delete
    ]
    hits := Ets new: #httpServerTestHits type: #set
    self.srv := HTTPServer
      start: 0
      handler: [:req |
        (Ets named: #httpServerTestHits) at: #ran put: true
        HTTPResponse new: #{#status => 200, #body => "ok"}
      ]
    url := "http://127.0.0.1:" ++ self.srv port asString ++ "/hello?name=%FF"
    resp := (HTTPClient get: url) unwrap
    ran := hits at: #ran ifAbsent: [false]
    hits delete
    self assert: resp status equals: 400
    self assert: resp body equals: "Bad Request: invalid UTF-8 in query"
    self deny: ran

  // ===== Response codes =====
  testCustomStatusCode =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 404, #body => "not found"}
    ]
    url := "http://localhost:" ++ self.srv port asString ++ "/missing"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 404
    self assert: resp body equals: "not found"

  testMethodBasedRouting =>
    self.srv := HTTPServer
      start: 0
      handler: [:req |
        m := req method
        m == "GET" ifTrue: [
          HTTPResponse new: #{#status => 200, #body => "get ok"}
        ] ifFalse: [
          HTTPResponse new: #{#status => 405, #body => "method not allowed"}
        ]
      ]
    url := "http://localhost:" ++ self.srv port asString ++ "/route"
    getResp := (HTTPClient get: url) unwrap
    self assert: getResp status equals: 200
    self assert: getResp body equals: "get ok"
    deleteResp := (HTTPClient delete: url) unwrap
    self assert: deleteResp status equals: 405

  // ===== Router =====
  testEncodedPathParamStaysRaw =>
    router := HTTPRouter
      routes: #(HTTPRoute
        get: "/users/:id"
        handler: [:req |
          HTTPResponse new: #{
            #status => 200,
            #body => "id=" ++ (req params at: "id")
          }
        ])
    self.srv := HTTPServer start: 0 handler: router
    url := "http://localhost:" ++ self.srv port asString ++ "/users/%34%32"
    resp := (HTTPClient get: url) unwrap
    self assert: resp body equals: "id=%34%32"

  // ===== Connection reuse (raw socket; backend-agnostic) =====
  testKeepAliveServesTwoRequests =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ka"}
    ]
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    first := self rawGet: client path: "/one"
    second := self rawGet: client path: "/two"
    (Erlang gen_tcp) close: client
    self assert: (first includesSubstring: "200 OK")
    self assert: (first includesSubstring: "ka")
    self assert: (second includesSubstring: "200 OK")
    self assert: (second includesSubstring: "ka")

  testPipelinedRequests =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => req path}
    ]
    port := self.srv port
    client := ((Erlang gen_tcp)
      connect: {127, 0, 0, 1}
      with: port
      with: #(#binary, {#packet, #raw}, {#active, #false})) unwrap
    (Erlang gen_tcp) send: client with: "GET /a HTTP/1.1\r\nhost: x\r\n\r\nGET /b HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n"
    raw := ""
    [(raw includesSubstring: "/b") not]
      whileTrue: [
        raw := raw
          concat: (((Erlang gen_tcp)
            recv: client
            with: 0
            with: 2000) unwrap) asStringUnchecked
      ]
    (Erlang gen_tcp) close: client
    self assert: (raw includesSubstring: "200 OK")
    self assert: (raw includesSubstring: "/a")
    self assert: (raw includesSubstring: "/b")

  rawGet: client path: path =>
    (Erlang gen_tcp) send: client with: "GET " ++ path ++ " HTTP/1.1\r\nhost: x\r\n\r\n"
    head := ""
    [(head includesSubstring: "\r\n\r\n") not]
      whileTrue: [
        head := head
          concat: (((Erlang gen_tcp)
            recv: client
            with: 1
            with: 2000) unwrap)
      ]
    body := ((Erlang gen_tcp)
      recv: client
      with: 2
      with: 2000) unwrap
    head concat: body asStringUnchecked

  // ===== IPv6 dialing =====
  testClientDialsIpv6Literal =>
    self.srv := HTTPServer
      start: 0
      handler: [:req | HTTPResponse new: #{#status => 200, #body => "v6dial"}]
      options: #{#bind => "::1"}
    url := "http://[::1]:" ++ self.srv port asString ++ "/"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "v6dial"

  // ===== cowboy was removed in 0.3.0 (BT-4087) =====
  testCowboyBackendOptionRaises =>
    self
      should: [
        HTTPServer
          start: 0
          handler: [:req | HTTPResponse new: #{#status => 200, #body => "ok"}]
          options: #{#backend => #cowboy}
      ]
      raise: #argument_error

  testCowboyBackendErrorExplainsRemoval =>
    hint := [
      HTTPServer
        start: 0
        handler: [:req | HTTPResponse new: #{#status => 200, #body => "ok"}]
        options: #{#backend => #cowboy}
    ] on: Error do: [:e | e hint]
    self assert: (hint includesSubstring: "removed in http 0.3.0")

  testUnknownBackendRaisesArgumentError =>
    self
      should: [
        HTTPServer
          start: 0
          handler: [:req | HTTPResponse new: #{#status => 200, #body => "ok"}]
          options: #{#backend => #bogus}
      ]
      raise: #argument_error

  // Streaming values work on the only backend; cowboy 500'd them.
  testStreamWithServes =>
    self.srv := HTTPServer
      start: 0
      handler: [:req |
        HTTPResponse
          streamWith: [:resp |
            resp startChunked: 200 headers: #(#("content-type", "text/plain"))
            resp sendChunk: "streamed"
            resp finish
          ]
      ]
    url := "http://localhost:" ++ self.srv port asString ++ "/stream"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200
    self assert: resp body equals: "streamed"

  // ===== Identity =====
  testPrintString =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => "ok"}
    ]
    str := self.srv printString
    self assert: (str startsWith: "an HTTPServer(port: ")

  testClassIdentity => self assert: HTTPServer superclass equals: Actor

  // BT-4172: binary fields still render — `asStringUnchecked` is exact
  // for valid UTF-8 and keeps printString working across the flip.
  testHTTPRequestPrintStringWithBinaryFields =>
    req := HTTPRequest
      new: #{
        #method => Binary fromBytes: #(71, 69, 84),
        #path => Binary fromBytes: #(47, 120)
      }
    self assert: req printString equals: "an HTTPRequest(GET /x)"

  testHTTPRequestPrintString =>
    self.srv := HTTPServer start: 0 handler: [:req |
      HTTPResponse new: #{#status => 200, #body => req printString}
    ]
    url := "http://localhost:" ++ self.srv port asString ++ "/identity"
    resp := (HTTPClient get: url) unwrap
    ps := resp body asStringUnchecked
    self assert: (ps startsWith: "an HTTPRequest(")
