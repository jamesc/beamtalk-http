/// QueryParser — decodes a raw HTTP query string into parameters.
///
/// Plug-layer parsing (the `fetch_query_params` half of the split with
/// the engine): the engine hands over the raw query string and this
/// answers the `Dictionary` behind `HTTPRequest>>queryParams`. Kept as
/// its own stateless unit so any backend adapter maps the same way.
Object subclass: QueryParser

  /// Raw query string to parameters, with cowboy's `parse_qs` rules (as
  /// beamtalk-http 0.2 parsed them): `?flag`
  /// means `"true"`, `+` is a space, `%XX` decodes a byte, and empty
  /// segments (a trailing or doubled `&`) are skipped. Answers nil
  /// when a part is not valid UTF-8, which the caller turns into a 400
  /// (the 0.2 cowboy server crashed on those into a 500).
  class parse: query :: String | Nil -> Dictionary(String, String) | Nil =>
    query isNil ifTrue: [^#{}]
    query =:= "" ifTrue: [^#{}]
    out := Dictionary new
    parts := (query split: "&") reject: [:part | part isEmpty]
    parts
      do: [:part |
        idx := part indexOf: "="
        key := self decodePart: (idx isNil ifTrue: [
          part
        ] ifFalse: [part take: idx - 1])
        val := idx isNil ifTrue: [
          "true"
        ] ifFalse: [self decodePart: (part drop: idx)]
        (key isNil or: [val isNil]) ifTrue: [^nil]
        out := out at: key put: val
      ]
    out

  class decodePart: s :: String -> String | Nil =>
    pieces := self decodePieces: s into: #()
    pieces isNil ifTrue: [^nil]
    String withAll: pieces

  /// Literal head runs plus one decoded `%`-run per piece, joined once
  /// at the end. Jumping run-to-run keeps this linear in the input —
  /// the old per-character walk copied the output on every char
  /// (quadratic) with stack depth to match.
  class decodePieces: rest :: String into: pieces :: List(String) -> List(String) | Nil =>
    idx := rest indexOf: "%"
    idx isNil ifTrue: [^pieces add: (rest replaceAll: "+" with: " ")]
    head := (rest take: idx - 1) replaceAll: "+" with: " "
    run := self percentRun: (rest drop: idx - 1) into: #()
    run isNil ifTrue: [^nil]
    tail := run at: 2
    decoded := (Binary fromBytes: (run at: 1)) asString
    decoded isError ifTrue: [^nil]
    self decodePieces: tail into: ((pieces add: head) add: decoded value)

  /// Consume all contiguous `%XX` groups at the head of `s`: answers
  /// `{bytes, rest}` or nil on a short or non-hex group.
  class percentRun: s :: String -> Tuple(List(Integer), String) | Nil =>
    self percentRun: s into: #()

  class percentRun: rest :: String into: bytes :: List(Integer) -> Tuple(List(Integer), String) | Nil =>
    ((rest size >= 3) and: [
      (rest at: 1) =:= "%"
    ]) ifFalse: [^bytes isEmpty ifTrue: [nil] ifFalse: [{bytes, rest}]]
    hi := self nibble: (rest at: 2)
    lo := self nibble: (rest at: 3)
    (hi isNil or: [lo isNil]) ifTrue: [^nil]
    self percentRun: (rest drop: 3) into: (bytes add: hi * 16 + lo)

  class nibble: ch :: String -> Integer | Nil =>
    pos := "0123456789ABCDEFabcdef" indexOf: ch
    pos isNil ifTrue: [^nil]
    pos <= 16 ifTrue: [^pos - 1]
    pos - 7
