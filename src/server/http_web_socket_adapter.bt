/// HttpWebSocketAdapter — Buccaneer's `WebSock` over a beamtalk-http
/// `WebSocketHandler`.
///
/// A Value holding the handler class, the upgrade's `HTTPRequest`,
/// the current handler state and the `WebSocketHandle`. The engine
/// drives it in the connection process: `init` builds the handle
/// and answers the handler's first state, `handleIn:` runs the data
/// callbacks, `handleInfo:` runs `onInfo:` (or answers a queued
/// `WebSocketHandle` frame as a push), and `terminate:` runs
/// `onClose:`. While a callback runs, the handle queues its frames
/// with the adapter, which answers them as that callback's push (or
/// stop), so a frame costs no second trip through the mailbox.
///
/// The adapter never implements `handleControl:`, so the engine
/// answers pings itself and the handler never sees them.
///
/// `terminate:` answers the handler's `onClose:` answer so tests can
/// observe it; the engine ignores it.
sealed Value subclass: HttpWebSocketAdapter
  field: handlerClass :: Object = nil
  field: request :: Object = nil
  field: state :: Object = nil
  field: ws :: Object = nil

  /// A handler for `handlerClass` and the upgrade's `request`. The
  /// handle and first state arrive in `init`, in the connection
  /// process.
  ///
  /// ## Arguments
  /// - `hc` (Object) — the `WebSocketHandler` class.
  /// - `req` (HTTPRequest) — the upgrade request, passed to
  ///   `onOpen:request:`.
  class handler: hc :: Object request: req :: HTTPRequest -> HttpWebSocketAdapter =>
    (self new withHandlerClass: hc) withRequest: req

  init -> WebSocketResult =>
    handle := WebSocketHandle for: Pid current
    self openQueue
    first := self handlerClass onOpen: handle request: self request
    ((self withState: first) withWs: handle) answerQueued

  handleIn: frame :: Tuple(Symbol, Binary) -> WebSocketResult =>
    self openQueue
    next := frame match: [
      {#text, t} -> self state onText: (self textOf: t) ws: self ws;
      {#binary, b} -> self state onBinary: b ws: self ws
    ]
    (self withState: next) answerQueued

  /// A text frame's payload as the String `onText:` takes: the engine
  /// has already checked it is UTF-8.
  textOf: t :: Binary -> String => t asStringUnchecked

  /// Open the handle's queue for the callback about to run (see
  /// `WebSocketHandle>>queue:`).
  openQueue -> Object => Erlang erlang put: WebSocketHandle queueKey with: #()

  /// Close the queue and answer what the callback queued, in order: a
  /// push of its frames, a stop at its first close (with the frames
  /// before it), or a plain ok.
  answerQueued -> WebSocketResult =>
    queued := Erlang erlang erase: WebSocketHandle queueKey
    queued match: [
      q :: List -> nil;
      _ -> ^WebSocketResult ok: self
    ]
    queued isEmpty ifTrue: [^WebSocketResult ok: self]
    queued size =:= 1 ifTrue: [^self sendPayload: (queued at: 1)]
    frames := #()
    queued
      do: [:payload |
        result := self sendPayload: payload
        result kind =:= #stop
          ifTrue: [
            ^WebSocketResult
              stop: self
              code: result code
              frames: frames
          ]
        frames := frames add: (result frames at: 1)
      ]
    WebSocketResult push: frames state: self

  handleInfo: message :: Object -> WebSocketResult =>
    message match: [
      {#wsSend, payload} -> self sendPayload: payload;
      _ -> self infoToHandler: message
    ]

  /// One queued `WebSocketHandle` frame: push it, or stop.
  sendPayload: payload :: Object -> WebSocketResult =>
    payload match: [
      #close -> WebSocketResult stop: self;
      {#close, code} -> code match: [
        c :: Integer -> WebSocketResult stop: self code: c;
        _ -> Error signal: "unknown WebSocketHandle close message"
      ];
      {#text, data} -> data match: [
        t :: Binary -> WebSocketResult push: {#text, t asStringUnchecked} state: self;
        t :: String -> WebSocketResult push: {#text, t} state: self;
        _ -> Error signal: "unknown WebSocketHandle text message"
      ];
      {#binary, data} -> data match: [
        b :: Binary -> WebSocketResult push: {#binary, b} state: self;
        _ -> Error signal: "unknown WebSocketHandle binary message"
      ];
      _ -> Error signal: "unknown WebSocketHandle message"
    ]

  /// Any other message: the handler's `onInfo:`, when it has one.
  infoToHandler: message :: Object -> WebSocketResult =>
    (self state respondsTo: #onInfo:ws:)
      ifTrue: [
        self openQueue
        next := self state onInfo: message ws: self ws
        (self withState: next) answerQueued
      ]
      ifFalse: [WebSocketResult ok: self]

  terminate: reason :: Object -> Object =>
    (self state respondsTo: #onClose:) ifTrue: [
      self state onClose: reason
    ] ifFalse: [nil]
