/// HttpExchangeAdapter — maps Buccaneer's engine interface onto
/// beamtalk-http's `HTTPRequest` / `HTTPResponse`.
///
/// Runs inside the connection process: builds an `HTTPRequest` from the
/// `Exchange`, dispatches to a block, an `HTTPHandler` actor or an
/// `HTTPRouter`, and answers with `sendResp:`, `sendFile:` or a streamed
/// `streamWith:` block. Behaviour differences from cowboy are noted in
/// the README.
Object subclass: HttpExchangeAdapter

  /// Largest request body read at once (8 MB, as Bandit): `req body`
  /// answers 413 past it, while `req readChunk` streams past it in parts.
  class maxBodyBytes -> Integer => 8000000

  /// Serve one request: build the `HTTPRequest`, dispatch, send the
  /// `HTTPResponse`. Answers 400 for a request the handler must never
  /// see (non-UTF-8 header value or query part, malformed body framing),
  /// 413 for an over-large body, and 500 for anything else — a raise in
  /// the handler or a non-`HTTPResponse` answer included, as the cowboy
  /// backend does. The engine strips HEAD/204/304 bodies itself and
  /// sends `100 Continue` when the handler first reads the body.
  ///
  /// Engine errors pass through untouched: `TransportError` (dead
  /// socket) and `HTTPError` (protocol problems the pipeline maps to a
  /// status itself) must reach the engine's own error paths, not the
  /// 500 below. So does a raise once the response has started (a
  /// `streamWith:` block raising after `startChunked:headers:`): a 500 is
  /// impossible then, so the engine closes the connection and logs it.
  class serve: ex :: Exchange handler: handler -> Object =>
    [self respond: ex handler: handler]
      on: Exception
      do: [:e |
        ((e isKindOf: TransportError) or: [
          e isKindOf: HTTPError
        ]) ifTrue: [e pass]
        started := [
          ex state =:= #sent or: [ex state =:= #chunked]
        ] on: Error do: [:err | false]
        // A raise after the response started — including `req body`
        // answering 413 itself once over the limit — passes through to
        // the engine, which closes the connection and logs it.
        started ifTrue: [e pass]
        Logger error: ("HTTP handler failed: " ++ e printString) metadata: #{
          #domain => #(#http)
        }
        self send500: ex
      ]

  class respond: ex :: Exchange handler: handler -> Object =>
    query := QueryParser parse: ex query
    query isNil ifTrue: [^self send400: ex reason: "invalid UTF-8 in query"]
    headers := self requestHeaders: ex headers
    headers isNil ifTrue: [^self send400: ex reason: "invalid UTF-8 in header"]
    lazy := (handler isKindOf: Block) or: [handler isKindOf: HTTPRouter]
    body := ""
    lazy
      ifFalse: [
        body := self readBody: ex
        body isNil ifTrue: [^nil]
      ]
    req := HTTPRequest
      new: #{
        #method => ex method,
        #path => ex path,
        #headers => headers,
        #body => body,
        #queryParams => query,
        #params => #{},
        #exchange => ex
      }
    resp := self dispatch: handler request: req
    (resp isKindOf: HTTPResponse) ifFalse: [^self send500: ex]
    stream := resp stream
    stream notNil ifTrue: [^self runStream: ex block: stream]
    file := resp file
    file notNil
      ifTrue: [
        ^self
          sendFileResponse: ex
          response: resp
          path: file
      ]
    drained := self readBody: ex
    drained isNil ifTrue: [^nil]
    ex
      sendResp: resp status
      headers: (self responseHeaders: resp headers)
      body: resp body

  /// Run a `streamWith:` block in the connection process with a writer
  /// over the exchange. A clean return without `finish` finishes the
  /// response (`commit` sends the closing chunk); a clean return that
  /// never started is a 500. A raise propagates to `serve`, which passes
  /// it to the engine once the headers are out (close and log) and 500s
  /// otherwise.
  class runStream: ex :: Exchange block: block :: Block(HttpChunkWriter, Object) -> Object =>
    block value: (HttpChunkWriter exchange: ex)
    ex state match: [
      #chunked -> ex commit;
      #unset -> self send500: ex;
      _ -> nil
    ]

  /// Send a `file:` / `file:offset:length:` response, draining an unread
  /// body first so over-large and malformed bodies keep their 413 and 400.
  class sendFileResponse: ex :: Exchange response: resp :: HTTPResponse path: path :: String -> Object =>
    drained := self readBody: ex
    drained isNil ifTrue: [^nil]
    ex
      sendFile: resp status
      headers: (self responseHeaders: resp headers)
      path: path
      offset: resp fileOffset
      length: resp fileLength

  /// Dispatch to a block, an `HTTPHandler` actor (a real actor send, as
  /// the cowboy backend does) or an `HTTPRouter`. The router matcher
  /// stays native, shared with the cowboy backend.
  class dispatch: handler request: req :: HTTPRequest -> Object =>
    (handler isKindOf: Block) ifTrue: [^handler value: req]
    (handler isKindOf: HTTPRouter) ifTrue: [
      ^self dispatchRouter: handler request: req
    ]
    handler handle: req

  class dispatchRouter: router :: HTTPRouter request: req :: HTTPRequest -> Object =>
    matched := router match: req method path: req path
    matched =:= #method_not_allowed
      ifTrue: [
        ^HTTPResponse
          new: #{
            #status => 405,
            #headers => #(#("content-type", "text/plain")),
            #body => "Method Not Allowed"
          }
      ]
    matched =:= #not_found
      ifTrue: [
        nf := router notFoundHandler
        nf isNil
          ifTrue: [
            ^HTTPResponse
              new: #{
                #status => 404,
                #headers => #(#("content-type", "text/plain")),
                #body => "Not Found"
              }
          ]
        ^nf value: req
      ]
    {_, h, p} := matched
    h value: (req withParams: p)

  /// Engine header tuples to `HTTPRequest` pairs. Names are lowercase
  /// Strings by the time the engine hands them over; values may be
  /// opaque Binaries, which cowboy would reject — answer nil so the
  /// caller sends 400 without running the handler.
  class requestHeaders: headers -> List(List(String)) | Nil =>
    out := #()
    headers
      do: [:t |
        name := t at: 1
        value := t at: 2
        (name isKindOf: String) ifFalse: [^nil]
        text := self headerValueText: value
        text isNil ifTrue: [^nil]
        out := out add: #(name, text)
      ]
    out

  /// A header value to text: Strings pass through, Binaries must be
  /// valid UTF-8 (nil otherwise, so the caller answers 400).
  class headerValueText: value -> String | Nil =>
    (value isKindOf: String) ifTrue: [^value]
    converted := value asString
    converted isError ifTrue: [^nil]
    converted value

  /// The whole body: a String when valid UTF-8, a Binary otherwise.
  /// Before dispatch (actor handlers, as the cowboy backend reads it
  /// before dispatch) and after it (draining an unread body before a
  /// plain or file response). Answers nil after sending 400 (malformed
  /// framing — the engine raises `HTTPError` for those, documented
  /// there as "a 400") or 413 (over-large body). A dead socket signals
  /// `TransportError` so the engine takes its quiet transport-error path
  /// instead of a 500; anything else raises.
  class readBody: ex :: Exchange -> String | Binary | Nil =>
    read := [ex readAll: self maxBodyBytes]
      on: HTTPError
      do: [:e |
        self send400: ex reason: "malformed request body"
        nil
      ]
    read isNil ifTrue: [^nil]
    read isError
      ifTrue: [
        // The 413 is already on the wire here: answer nil so the caller
        // returns without sending a second response (sendResp: answers
        // the Exchange, not nil — a second send would raise AlreadySent).
        read error =:= #body_too_large
          ifTrue: [
            self send413: ex
            ^nil
          ]
        read error =:= #closed ifTrue: [
          TransportError signal: "client closed connection during body read"
        ]
        Error signal: ("Request body read failed: " ++ read error printString)
      ]
    data := read value
    (data isKindOf: String) ifTrue: [^data]
    converted := data asString
    converted isError ifTrue: [^data]
    converted value

  /// `HTTPResponse` header pairs to engine tuples.
  class responseHeaders: headers :: List(List(String)) -> List(Tuple) =>
    headers collect: [:pair | {(pair at: 1), (pair at: 2)}]

  /// A `#bind` address to the `{ip, inet6?}` pair Catalina's transport
  /// options take: v4 dotted quads as before, plus full and `::`-
  /// compressed IPv6 with an optional embedded v4 tail. The engine
  /// forwards `#inet6`, mirroring cowboy's `inet:parse_address` —
  /// probed edge-for-edge (`::` must compress at least one group,
  /// zones and triple colons rejected). Raises like the cowboy
  /// backend does for anything else.
  class parseBind: bind :: String -> Tuple =>
    (bind includesSubstring: ":") ifTrue: [
      ^self parseBindIp6: bind
    ] ifFalse: [^self parseBindIp4: bind]

  class parseBindIp4: bind :: String -> Tuple =>
    parts := bind split: "."
    parts size =:= 4 ifFalse: [self badBind]
    octets := parts collect: [:p | self parseOctet: p]
    {{(octets at: 1), (octets at: 2), (octets at: 3), (octets at: 4)}, false}

  class parseBindIp6: bind :: String -> Tuple =>
    halves := bind split: "::"
    halves size > 2 ifTrue: [self badBind]
    head := self splitGroups: (halves at: 1)
    tail := halves size =:= 2 ifTrue: [
      self splitGroups: (halves at: 2)
    ] ifFalse: [#()]
    headVals := self expandHexGroups: head
    tailVals := self expandBindTail: tail
    explicit := headVals size + tailVals size
    halves size =:= 2 ifTrue: [
      explicit > 7 ifTrue: [self badBind]
    ] ifFalse: [explicit =:= 8 ifFalse: [self badBind]]
    full := headVals ++ (self zeros: 8 - explicit) ++ tailVals
    {{(full at: 1), (full at: 2), (full at: 3), (full at: 4), (full at: 5), (full at: 6), (full at: 7), (full at: 8)}, true}

  class splitGroups: s :: String -> List(String) =>
    s isEmpty ifTrue: [^#()]
    s split: ":"

  class expandHexGroups: groups :: List(String) -> List(Integer) =>
    groups collect: [:g | self parseHexGroup: g]

  /// All groups but the last as hex; the last may be an embedded v4 tail.
  class expandBindTail: groups :: List(String) -> List(Integer) =>
    groups isEmpty ifTrue: [^#()]
    groups size =:= 1 ifTrue: [^self parseBindGroup: (groups at: 1) last: true]
    (self expandHexGroups: (groups take: groups size - 1))
      ++ (self parseBindGroup: (groups at: groups size) last: true)

  /// One textual group to 16-bit values: plain hex, or (only as the
  /// last group) an embedded v4 tail answering two values.
  class parseBindGroup: g :: String last: isLast :: Boolean -> List(Integer) =>
    dotted := g includesSubstring: "."
    dotted
      ifTrue: [
        isLast ifFalse: [self badBind]
        ^self parseEmbeddedV4: g
      ]
    #((self parseHexGroup: g))

  class parseEmbeddedV4: g :: String -> List(Integer) =>
    octets := (g split: ".") collect: [:o | self parseOctet: o]
    octets size =:= 4 ifFalse: [self badBind]
    #((octets at: 1) * 256 + (octets at: 2), (octets at: 3) * 256 + (octets at: 4))

  class parseHexGroup: g :: String -> Integer =>
    ((g size >= 1) and: [g size <= 4]) ifFalse: [self badBind]
    self parseHexGroup: g into: 0

  class parseHexGroup: rest :: String into: n :: Integer -> Integer =>
    rest isEmpty ifTrue: [^n]
    d := QueryParser nibble: (rest take: 1)
    d isNil ifTrue: [self badBind]
    self parseHexGroup: (rest drop: 1) into: n * 16 + d

  class zeros: n :: Integer -> List(Integer) =>
    n =:= 0 ifTrue: [^#()]
    (self zeros: n - 1) add: 0

  class badBind -> Never =>
    Error signal: "Bind must be an IP address (e.g. 127.0.0.1 or ::1)"

  class parseOctet: s :: String -> Integer =>
    n := [
      s asInteger
    ] on: Exception do: [:e |
      Error signal: "Bind must be an IPv4 address (e.g. 127.0.0.1)"
    ]
    (n < 0 or: [
      n > 255
    ]) ifTrue: [Error signal: "Bind must be an IPv4 address (e.g. 127.0.0.1)"]
    n

  class send400: ex :: Exchange reason: why :: String -> Object =>
    ex
      sendResp: 400
      headers: #({"content-type", "text/plain"})
      body: ("Bad Request: " ++ why)

  class send413: ex :: Exchange -> Object =>
    ex
      sendResp: 413
      headers: #({"content-type", "text/plain"})
      body: "Request Entity Too Large"

  class send500: ex :: Exchange -> Object =>
    ex
      sendResp: 500
      headers: #({"content-type", "text/plain"})
      body: "Internal Server Error"
