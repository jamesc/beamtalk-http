/// HttpExchangeAdapter — maps Buccaneer's engine interface onto
/// beamtalk-http's `HTTPRequest` / `HTTPResponse`.
///
/// Runs inside the connection process: builds an `HTTPRequest` from the
/// `Exchange`, dispatches to a block, an `HTTPHandler` actor or an
/// `HTTPRouter`, and answers with `sendResp:`, `sendFile:` or a streamed
/// `streamWith:` block. Behaviour differences from the cowboy server
/// that 0.2 shipped are listed in the CHANGELOG (0.3.0).
typed Object subclass: HttpExchangeAdapter

  /// Largest request body read at once (8 MB, as Bandit): `req body`
  /// answers 413 past it, while `req readChunk` streams past it in parts.
  class maxBodyBytes -> Integer => 8000000

  /// Serve one request: build the `HTTPRequest`, dispatch, send the
  /// `HTTPResponse`. Answers 400 for a request the handler must never
  /// see (non-UTF-8 header value or query part, malformed body framing),
  /// 413 for an over-large body, and 500 for anything else — a raise in
  /// the handler or a non-`HTTPResponse` answer included. The engine strips HEAD/204/304 bodies itself and
  /// sends `100 Continue` when the handler first reads the body.
  ///
  /// Engine errors pass through untouched: `TransportError` (dead
  /// socket) and `HTTPError` (protocol problems the pipeline maps to a
  /// status itself) must reach the engine's own error paths, not the
  /// 500 below. So does a raise once the response has started (a
  /// `streamWith:` block raising after `startChunked:headers:`): a 500 is
  /// impossible then, so the engine closes the connection and logs it.
  ///
  /// Decides the handler's shape on every call; `HTTPServer` decides it
  /// once at start and calls `serve:handler:kind:` instead.
  class serve: ex :: Exchange handler: handler :: Object -> Object =>
    self
      serve: ex
      handler: handler
      kind: (self handlerKind: handler)

  /// `serve:handler:` with the handler's shape already decided by
  /// `handlerKind:`, so a request does no `isKindOf:` checks on it.
  class serve: ex :: Exchange handler: handler :: Object kind: kind :: Symbol -> Object =>
    [
      self
        respond: ex
        handler: handler
        kind: kind
    ]
      on: Exception
      do: [:e |
        ((e isKindOf: TransportError) or: [
          e isKindOf: HTTPError
        ]) ifTrue: [e pass]
        started := [
          ex state =:= #sent or: [ex state =:= #chunked]
        ] on: Error do: [:err | false]
        // A raise after the response started — including `req body`
        // answering 413 itself once over the limit — passes through to
        // the engine, which closes the connection and logs it.
        started ifTrue: [e pass]
        Logger error: ("HTTP handler failed: " ++ e printString) metadata: #{
          #domain => #(#http)
        }
        self send500: ex
      ]

  /// The handler's shape: `#block` (a block, `PlugChain`s included),
  /// `#router` (an `HTTPRouter`) or `#actor` (anything answering
  /// `handle:`, an `HTTPHandler` actor).
  class handlerKind: handler :: Object -> Symbol =>
    (handler isKindOf: Block) ifTrue: [^#block]
    (handler isKindOf: HTTPRouter) ifTrue: [^#router]
    #actor

  class respond: ex :: Exchange handler: handler :: Object kind: kind :: Symbol -> Object =>
    query := QueryParser parse: ex query
    query isNil ifTrue: [^self send400: ex reason: "invalid UTF-8 in query"]
    raw := ex headers
    headers := self requestHeaders: raw
    headers isNil ifTrue: [^self send400: ex reason: "invalid UTF-8 in header"]
    // Actor handlers get the whole body before dispatch (they run in
    // another process); blocks and routers read it lazily through
    // `req body` / `req readChunk`.
    preRead := kind =:= #actor
    body := ""
    preRead
      ifTrue: [
        body := self readBody: ex
        body isNil ifTrue: [^nil]
      ]
    req := HTTPRequest
      method: ex method
      path: ex path
      headers: headers
      body: body
      queryParams: query
      params: #{}
      exchange: ex
    resp := self
      dispatch: handler
      kind: kind
      request: req
    (resp isKindOf: HTTPResponse) ifFalse: [^self send500: ex]
    // A body read before dispatch is already drained, and so is a
    // request that cannot have one.
    drain := preRead not and: [self mayHaveBody: ex headers: raw]
    self
      send: resp
      on: ex
      request: req
      drain: drain

  /// Send `resp`, whatever its shape: a WebSocket upgrade, a stream, a
  /// file or a plain body. `drain` reads an unread request body first,
  /// so over-large and malformed bodies keep their 413 and 400.
  class send: resp :: HTTPResponse on: ex :: Exchange request: req :: HTTPRequest drain: drain :: Boolean -> Object =>
    resp websocketHandler notNil
      ifTrue: [
        ^self
          runUpgrade: ex
          response: resp
          request: req
      ]
    stream := resp stream
    stream notNil ifTrue: [^self runStream: ex block: stream]
    // BT-4500: an exchange whose body was already read to its end (the
    // handler called `req body`) has nothing left to drain.
    (drain and: [(self bodyComplete: ex) not])
      ifTrue: [
        drained := self readRaw: ex
        drained isNil ifTrue: [^nil]
      ]
    file := resp file
    file notNil
      ifTrue: [
        ^ex
          sendFile: resp status
          headers: (self responseHeaders: resp headers)
          path: file
          offset: resp fileOffset
          length: resp fileLength
      ]
    ex
      sendResp: resp status
      headers: (self responseHeaders: resp headers)
      body: resp body

  /// Whether the exchange's request body was read to its end (or there was
  /// none): `Exchange>>bodyComplete`, a local-state read (Buccaneer after
  /// #39). An older Buccaneer without it answers false, so the caller
  /// falls back to the drain. `ex` is `Dynamic` because the static
  /// `Exchange` of an older Buccaneer has no such selector.
  class bodyComplete: ex :: Dynamic -> Boolean =>
    (ex respondsTo: #bodyComplete) ifFalse: [^false]
    ex bodyComplete =:= true

  /// Whether the request may still have an unread body. On HTTP/1 a
  /// request with no `content-length` (or `content-length: 0`) and no
  /// `transfer-encoding` has none, so the drain would only re-read
  /// nothing. An `expect` header keeps the drain, which is where the
  /// engine sends `100 Continue`. HTTP/2 can carry a body without
  /// `content-length`, so it always drains.
  class mayHaveBody: ex :: Exchange headers: raw :: HttpHeaders -> Boolean =>
    raw
      do: [:t |
        {name, value} := t
        name match: [
          "content-length" -> (value =:= "0") ifFalse: [^true];
          "transfer-encoding" -> ^true;
          "expect" -> ^true;
          _ -> nil
        ]
      ]
    ex httpProtocol =:= #http2

  /// Run a `streamWith:` block in the connection process with a writer
  /// over the exchange. A clean return without `finish` finishes the
  /// response (`commit` sends the closing chunk); a clean return that
  /// never started is a 500. A raise propagates to `serve`, which passes
  /// it to the engine once the headers are out (close and log) and 500s
  /// otherwise.
  /// Upgrade the connection to WebSocket through the response's
  /// handler class. The engine validates the request, sends 101 and
  /// hands the connection over after this answers.
  ///
  /// ## Arguments
  /// - `ex` (Exchange) — the upgrade exchange.
  /// - `response` (HTTPResponse) — carries the handler class in
  ///   `websocketHandler`.
  /// - `req` (HTTPRequest) — the upgrade request, passed to the
  ///   handler's `onOpen:request:`.
  class runUpgrade: ex :: Exchange response: resp :: HTTPResponse request: req :: HTTPRequest -> Object =>
    ex upgradeToWebSocket: (HttpWebSocketAdapter handler: resp websocketHandler request: req) options: #{}

  class runStream: ex :: Exchange block: block :: Block(HttpChunkWriter, Object) -> Object =>
    block value: (HttpChunkWriter exchange: ex)
    ex state match: [
      #chunked -> ex commit;
      #unset -> self send500: ex;
      _ -> nil
    ]

  /// Dispatch to a block, an `HTTPHandler` actor (a real actor send) or
  /// an `HTTPRouter`. `kind` is `handlerKind:`'s verdict on `handler`,
  /// decided once so a request does no `isKindOf:` checks; the handler is
  /// `Dynamic` here because the static type cannot follow that verdict.
  class dispatch: handler :: Dynamic kind: kind :: Symbol request: req :: HTTPRequest -> Object =>
    kind match: [
      #block -> handler value: req;
      #router -> self dispatchRouter: handler request: req;
      _ -> handler handle: req
    ]

  class dispatchRouter: router :: HTTPRouter request: req :: HTTPRequest -> Object =>
    matched := router match: req method path: req path
    matched =:= #method_not_allowed
      ifTrue: [
        ^HTTPResponse
          new: #{
            #status => 405,
            #headers => #(#("content-type", "text/plain")),
            #body => "Method Not Allowed"
          }
      ]
    matched =:= #not_found
      ifTrue: [
        nf := router notFoundHandler
        nf isNil
          ifTrue: [
            ^HTTPResponse
              new: #{
                #status => 404,
                #headers => #(#("content-type", "text/plain")),
                #body => "Not Found"
              }
          ]
        ^nf value: req
      ]
    {_, h, p} := matched
    h value: (req withParams: p)

  /// Engine header tuples to `HTTPRequest` pairs, in one pass. Names are
  /// lowercase Strings by the time the engine hands them over; values
  /// are Strings, or opaque Binaries when the engine could not decode
  /// them (HTTP/2 values, non-UTF-8 HTTP/1 values). A Binary must be
  /// valid UTF-8: answer nil otherwise so
  /// the caller sends 400 without running the handler.
  class requestHeaders: headers :: HttpHeaders -> List(List(String)) | Nil =>
    headers
      collect: [:t |
        {name, value} := t
        (name isKindOf: String) ifFalse: [^nil]
        // Fast path (BT-4500): a String value, the usual case, skips the
        // Binary branch and its UTF-8 validation.
        (value isKindOf: String)
          ifTrue: [#(name, value)]
          ifFalse: [
            (value isKindOf: Binary) ifFalse: [^nil]
            converted := value asString
            converted isError ifTrue: [^nil]
            #(name, converted value)
          ]
      ]

  /// The whole body: a String when valid UTF-8, a Binary otherwise.
  /// Before dispatch (actor handlers). Answers nil after sending 400 or
  /// 413 (see `readRaw:`).
  class readBody: ex :: Exchange -> String | Binary | Nil =>
    raw := self readRaw: ex
    raw isNil ifTrue: [^nil]
    self bodyValue: raw

  /// The rest of the body as the raw bytes, with no UTF-8 check: the
  /// post-handler drain of an unread body before a plain or file
  /// response, where the bytes are discarded (BT-4500: `bodyValue:` runs
  /// once per request, on the body the handler sees). Answers nil after
  /// sending 400 (malformed framing — the engine raises `HTTPError` for
  /// those, documented there as "a 400") or 413 (over-large body). A
  /// dead socket signals `TransportError` so the engine takes its quiet
  /// transport-error path instead of a 500; anything else raises.
  class readRaw: ex :: Exchange -> Binary | Nil =>
    read := [ex readAll: self maxBodyBytes]
      on: HTTPError
      do: [:e |
        self send400: ex reason: "malformed request body"
        nil
      ]
    read isNil ifTrue: [^nil]
    read isError
      ifTrue: [
        // The 413 is already on the wire here: answer nil so the caller
        // returns without sending a second response (sendResp: answers
        // the Exchange, not nil — a second send would raise AlreadySent).
        read error =:= #body_too_large
          ifTrue: [
            self send413: ex
            ^nil
          ]
        read error =:= #closed ifTrue: [
          TransportError signal: "client closed connection during body read"
        ]
        Error signal: ("Request body read failed: " ++ read error printString)
      ]
    read value

  /// A request body as the public `String | Binary` value: a String when
  /// the bytes are valid UTF-8, the Binary itself otherwise.
  ///
  /// `Binary>>asString` costs two `unicode:characters_to_binary/2` passes
  /// over the bytes (BT-4500: about 52 µs on a 64 KiB body). This does
  /// one validating pass with `characters_to_binary/1` — it answers the
  /// binary for valid UTF-8 and an `{error, ...}`/`{incomplete, ...}`
  /// tuple otherwise — then retags without a second check. An empty body
  /// skips the FFI call. A String passes through: the FFI check accepts
  /// it and `asStringUnchecked` answers it unchanged, so it needs no
  /// `isKindOf:` test of its own.
  class bodyValue: data :: Binary -> String | Binary =>
    data size =:= 0 ifTrue: [^""]
    checked := (Erlang unicode) characters_to_binary: data
    (checked isKindOf: Binary) ifFalse: [^data]
    data asStringUnchecked

  /// `HTTPResponse` header pairs to engine tuples.
  class responseHeaders: headers :: List(List(String)) -> List(Tuple) =>
    headers collect: [:pair | {(pair at: 1), (pair at: 2)}]

  /// A `#bind` address to the `{ip, inet6?}` pair Catalina's transport
  /// options take, via OTP's `inet:parse_address/1`. The `String` becomes a charlist with
  /// `Binary>>asCharlist` (UTF-8 bytes, not graphemes), since the FFI
  /// boundary maps a `String` arg to a binary. Anything else raises.
  class parseBind: bind :: String -> Tuple =>
    parsed := (Erlang inet) parse_address: (bind asCharlist)
    parsed isError ifTrue: [self badBind]
    addr := parsed unwrap
    (addr size =:= 4) ifTrue: [^{addr, false}]
    (addr size =:= 8) ifTrue: [^{addr, true}]
    self badBind

  class badBind -> Never =>
    Error signal: "Bind must be an IP address (e.g. 127.0.0.1 or ::1)"

  class send400: ex :: Exchange reason: why :: String -> Object =>
    ex
      sendResp: 400
      headers: #({"content-type", "text/plain"})
      body: ("Bad Request: " ++ why)

  class send413: ex :: Exchange -> Object =>
    ex
      sendResp: 413
      headers: #({"content-type", "text/plain"})
      body: "Request Entity Too Large"

  class send500: ex :: Exchange -> Object =>
    ex
      sendResp: 500
      headers: #({"content-type", "text/plain"})
      body: "Internal Server Error"
