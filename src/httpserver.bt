/// Anything `HTTPServer start:handler:` accepts as a request handler: a
/// plain block, an actor conforming to `HTTPHandler`, or a compiled
/// `HTTPRouter`.
///
/// These two forms have different state-visibility semantics:
///
/// - A **block** (or a compiled `HTTPRouter`, which dispatches to blocks
///   internally) is invoked as a direct function call inside the
///   backend's own request-handling process — cowboy's process on the
///   `#cowboy` backend, the connection process on `#buccaneer` — with
///   no actor mailbox involved. Any `self.field` the block closes over
///   is whatever was captured when the block/route table was built; it
///   is never re-read later, even if the actor's real state changes
///   afterward (including `attachX:`-style dependency injection
///   performed after `start:handler:` has already run). A `PlugChain`'s
///   composed handler is a block, so it inherits this too. On
///   `#buccaneer`, the engine's `Exchange` handles are owner-bound:
///   a block that hands the request off to another process gets a
///   `NotOwner` error there instead.
/// - An **`HTTPHandler`** actor is invoked via a genuine actor message
///   send (`handle:`), which runs inside the actor's own process — so
///   `self.field` reads are always current and further actor calls behave
///   normally.
///
/// Use a block/router for stateless request handling; back a route with an
/// `HTTPHandler` actor when it needs live or post-startup-configurable
/// state.
type HTTPHandlerLike = Block(HTTPRequest, HTTPResponse) | HTTPHandler | HTTPRouter

/// HTTPServer — cowboy-backed HTTP server actor for Beamtalk.
///
/// Wraps a cowboy listener lifecycle: start on a given port (or ephemeral
/// port 0), dispatch incoming requests to a handler, and stop gracefully.
///
/// The handler may be a block receiving an `HTTPRequest` and returning
/// an `HTTPResponse`, an actor conforming to the `HTTPHandler` protocol
/// (responding to `handle:`), or a compiled `HTTPRouter`.
///
/// Two backends serve requests alike: `#cowboy` (the default) and
/// `#buccaneer`, a pure-Beamtalk engine reached through
/// `HttpExchangeAdapter`. Anything the handler answers that is not an
/// `HTTPResponse` is a 500 on both, as is any raise. Known differences
/// are noted under "Backends" in the README — notably, the buccaneer
/// backend caps request bodies at 8 MB (413) while cowboy is unbounded.
///
/// As an Actor, HTTPServer can be supervised for automatic restart on
/// failure and integrates with the standard Actor lifecycle (`stop`,
/// `isAlive`, `monitor`).
///
/// ## Examples
/// ```beamtalk
/// srv := HTTPServer start: 8080 handler: [:req |
///   req method == "GET" ifTrue: [
///     HTTPResponse new: #{ #status => 200, #body => "hello" }
///   ] ifFalse: [
///     HTTPResponse new: #{ #status => 405, #body => "method not allowed" }
///   ]
/// ]
/// srv port   // => 8080
/// srv stop
/// ```
///
/// ## Ephemeral port
/// ```beamtalk
/// srv := HTTPServer start: 0 handler: [:req |
///   HTTPResponse new: #{ #status => 200, #body => "ok" }
/// ]
/// srv port   // => (dynamically assigned port)
/// srv stop
/// ```
///
/// @see HTTPClient (for making HTTP requests)
/// @see HTTPRequest (for incoming request objects)
/// @see HTTPResponse (for building response objects)
Actor subclass: HTTPServer native: beamtalk_http_server

  /// Start an HTTP server on the given port with a handler block or actor.
  ///
  /// Use port 0 for an ephemeral (OS-assigned) port.
  /// Binds to 127.0.0.1 by default.
  ///
  /// ## Examples
  /// ```beamtalk
  /// srv := HTTPServer start: 8080 handler: [:req |
  ///   HTTPResponse new: #{ #status => 200, #body => "hello" }
  /// ]
  /// ```
  class start: port :: Integer handler: handler :: HTTPHandlerLike -> Dynamic =>
    self
      start: port
      handler: handler
      options: #{}

  /// Start an HTTP server with additional options. Answers an
  /// `HTTPServer` on `#cowboy`, an `HTTPBuccaneerServer` on `#buccaneer`
  /// — both answer the same `port`, `stop` and `printString` shapes.
  ///
  /// Options:
  ///   - `#bind` — IP address to bind to (default `"127.0.0.1"`;
  ///     v4 dotted quads and IPv6 (with `::` compression) on both backends)
  ///   - `#backend` — `#cowboy` (default) or `#buccaneer`. When absent,
  ///     the `BEAMTALK_HTTP_BACKEND` environment variable selects the
  ///     backend (`"cowboy"` / `"buccaneer"`); unset (or empty) means
  ///     cowboy. The handler is validated at start on both backends:
  ///     a block, an `HTTPRouter`, or an actor responding to `handle:`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// srv := HTTPServer start: 0 handler: handler
  ///   options: #{ #bind => "0.0.0.0" }
  /// ```
  class start: port :: Integer handler: handler :: HTTPHandlerLike options: opts :: Dictionary(Symbol, Dynamic) -> Dynamic =>
    backend := self resolveBackend: opts
    backend =:= #buccaneer
      ifTrue: [
        ^HTTPBuccaneerServer
          spawnWith: #{
            #port => port,
            #handler => handler,
            #bind => (opts at: #bind ifAbsent: ["127.0.0.1"])
          }
      ]
    self spawnWith: (#{#port => port, #handler => handler} merge: opts)

  /// Which backend serves this server: the explicit `#backend` option,
  /// else `BEAMTALK_HTTP_BACKEND`, else `#cowboy`. An empty variable
  /// counts as unset (container runtimes often pass `-e FLAG=` empty).
  class resolveBackend: opts :: Dictionary(Symbol, Dynamic) -> Symbol =>
    explicit := opts at: #backend ifAbsent: [nil]
    explicit notNil
      ifTrue: [
        (explicit =:= #cowboy or: [
          explicit =:= #buccaneer
        ]) ifFalse: [
          Error signal: "Unknown HTTP backend; expected #cowboy or #buccaneer"
        ]
        ^explicit
      ]
    env := System getEnv: "BEAMTALK_HTTP_BACKEND"
    (env isNil or: [env =:= ""]) ifTrue: [^#cowboy]
    env =:= "buccaneer" ifTrue: [^#buccaneer]
    env =:= "cowboy" ifTrue: [^#cowboy]
    Error signal: "Unknown BEAMTALK_HTTP_BACKEND; expected cowboy or buccaneer"

  /// Return the TCP port this server is listening on.
  ///
  /// Useful when started with port 0 (ephemeral) to discover the
  /// actual assigned port.
  ///
  /// ## Examples
  /// ```beamtalk
  /// srv port   // => 8080
  /// ```
  port -> Integer => self delegate

  /// Human-readable representation.
  printString -> String => self delegate
