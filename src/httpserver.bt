/// Anything `HTTPServer start:handler:` accepts as a request handler: a
/// plain block, an actor conforming to `HTTPHandler`, or a compiled
/// `HTTPRouter`.
///
/// These two forms have different state-visibility semantics:
///
/// - A **block** (or a compiled `HTTPRouter`, which dispatches to blocks
///   internally) is invoked as a direct function call inside the
///   connection process that received the request, with no actor
///   mailbox involved. Any `self.field` the block closes over is
///   whatever was captured when the block/route table was built; it is
///   never re-read later, even if the actor's real state changes
///   afterward (including `attachX:`-style dependency injection
///   performed after `start:handler:` has already run). A `PlugChain`'s
///   composed handler is a block, so it inherits this too. The engine's
///   `Exchange` handles are owner-bound: a block that hands the request
///   off to another process gets a `NotOwner` error there instead.
/// - An **`HTTPHandler`** actor is invoked via a genuine actor message
///   send (`handle:`), which runs inside the actor's own process — so
///   `self.field` reads are always current and further actor calls behave
///   normally.
///
/// Use a block/router for stateless request handling; back a route with an
/// `HTTPHandler` actor when it needs live or post-startup-configurable
/// state.
type HTTPHandlerLike = Block(HTTPRequest, HTTPResponse) | HTTPHandler | HTTPRouter

/// The options `HTTPServer start:handler:options:` accepts: Symbol keys
/// with values checked at each use site. See `start:handler:options:`
/// for one bullet per key.
type HttpServerOptions = Dictionary(Symbol, Dynamic)

/// HTTPServer — HTTP server actor for Beamtalk, served by Buccaneer.
///
/// Owns a `Buccaneer` server (a pure-Beamtalk HTTP/1.1, HTTP/2 and
/// WebSocket engine) for its lifetime: start on a given port (or
/// ephemeral port 0), dispatch incoming requests to a handler through
/// `HttpExchangeAdapter`, and stop the engine when the actor stops.
///
/// The handler may be a block receiving an `HTTPRequest` and returning
/// an `HTTPResponse`, an actor conforming to the `HTTPHandler` protocol
/// (responding to `handle:`), or a compiled `HTTPRouter`. Anything the
/// handler answers that is not an `HTTPResponse` is a 500, as is any
/// raise. Request bodies read with `req body` are capped at 8 MB (413).
///
/// Until 0.3.0 the server ran on cowboy by default. The CHANGELOG lists
/// the behaviour differences from the cowboy server.
///
/// As an Actor, HTTPServer can be supervised for automatic restart on
/// failure and integrates with the standard Actor lifecycle (`stop`,
/// `isAlive`, `monitor`).
///
/// ## Examples
/// ```beamtalk
/// srv := HTTPServer start: 8080 handler: [:req |
///   req method == "GET" ifTrue: [
///     HTTPResponse new: #{ #status => 200, #body => "hello" }
///   ] ifFalse: [
///     HTTPResponse new: #{ #status => 405, #body => "method not allowed" }
///   ]
/// ]
/// srv port   // => 8080
/// srv stop
/// ```
///
/// ## Ephemeral port
/// ```beamtalk
/// srv := HTTPServer start: 0 handler: [:req |
///   HTTPResponse new: #{ #status => 200, #body => "ok" }
/// ]
/// srv port   // => (dynamically assigned port)
/// srv stop
/// ```
///
/// @see HTTPClient (for making HTTP requests)
/// @see HTTPRequest (for incoming request objects)
/// @see HTTPResponse (for building response objects)
typed Actor subclass: HTTPServer
  state: port :: Integer = 0
  state: handler :: HTTPHandlerLike | Nil = nil
  state: bind :: String = "127.0.0.1"
  state: server :: ServerSupervisor | Nil = nil
  // `listenerInfo` answers `{ip, port}` with the port as
  // `Integer | Binary` (Binary only for Unix sockets, which never bind
  // here); `initialize` checks it is the Integer port before storing it.
  state: actualPort :: Integer = 0

  /// Start an HTTP server on the given port with a handler block or actor.
  ///
  /// Use port 0 for an ephemeral (OS-assigned) port.
  /// Binds to 127.0.0.1 by default.
  ///
  /// ## Examples
  /// ```beamtalk
  /// srv := HTTPServer start: 8080 handler: [:req |
  ///   HTTPResponse new: #{ #status => 200, #body => "hello" }
  /// ]
  /// ```
  class start: port :: Integer handler: handler :: HTTPHandlerLike -> HTTPServer =>
    self
      start: port
      handler: handler
      options: #{}

  /// Start an HTTP server with additional options. The handler is
  /// validated before the server starts: a block, an `HTTPRouter`, or
  /// an actor responding to `handle:`.
  ///
  /// ## Arguments
  /// - `port` (Integer) — the port to listen on (`0` for an ephemeral port).
  /// - `handler` (HTTPHandlerLike) — answers each request; see `HTTPHandlerLike`.
  /// - `opts` (HttpServerOptions) — the server options, one entry per key below.
  ///
  /// ## Options
  /// - `#bind` (String, default `"127.0.0.1"`) — IP address to bind to; v4 dotted quads and IPv6 (with `::` compression).
  ///
  /// ## Examples
  /// ```beamtalk
  /// srv := HTTPServer start: 0 handler: handler
  ///   options: #{ #bind => "0.0.0.0" }
  /// ```
  class start: port :: Integer handler: handler :: HTTPHandlerLike options: opts :: HttpServerOptions -> HTTPServer =>
    self checkHandler: handler
    self
      spawnWith: #{
        #port => port,
        #handler => handler,
        #bind => (opts at: #bind ifAbsent: ["127.0.0.1"])
      }

  /// Raise a `type_error` unless `handler` is a block, an `HTTPRouter`
  /// or an actor responding to `handle:`.
  class checkHandler: handler :: Object -> Nil =>
    ((handler isKindOf: Block) or: [
      (handler isKindOf: HTTPRouter) or: [handler respondsTo: #handle:]
    ])
      ifFalse: [
        Exception
          signalKind: #type_error
          class: #HTTPServer
          selector: #start:handler:options:
          hint: "Invalid HTTP handler; expected a block, HTTPRouter or handle: actor"
      ]
    nil

  initialize -> Nil =>
    h := self.handler
    // Decided once here, not per request (BT-4466).
    kind := HttpExchangeAdapter handlerKind: h
    bound := HttpExchangeAdapter parseBind: self.bind
    srv := (Buccaneer
      start: #{
        #port => self.port,
        #ip => (bound at: 1),
        #inet6 => (bound at: 2),
        #startupLog => false,
        #handler => [:ex :: Exchange |
          HttpExchangeAdapter
            serve: ex
            handler: h
            kind: kind
        ]
      }) unwrap
    self.server := srv
    info := srv listenerInfo unwrap
    ((info isKindOf: Tuple) and: [info size =:= 2])
      ifFalse: [
        Error signal: "Buccaneer listenerInfo changed shape; update HTTPServer>>initialize"
      ]
    port := info at: 2
    (port isKindOf: Integer)
      ifFalse: [
        Error signal: "Buccaneer listenerInfo port is not an Integer; update HTTPServer>>initialize"
      ]
    self.actualPort := port
    nil

  /// Return the TCP port this server is listening on.
  ///
  /// Useful when started with port 0 (ephemeral) to discover the
  /// actual assigned port.
  ///
  /// ## Examples
  /// ```beamtalk
  /// srv port   // => 8080
  /// ```
  port -> Integer => self.actualPort

  /// Human-readable representation: "an HTTPServer(port: 8080)".
  printString -> String =>
    "an HTTPServer(port: " ++ self.actualPort asString ++ ")"

  /// Stop the engine with the actor. Guarded: the engine may already be
  /// gone (crash, OOM-killer), and shutdown must not raise.
  terminate: _reason :: Object -> Nil =>
    self.server isNil ifFalse: [
      [self.server stop: 5000] on: Exception do: [:e | nil]
    ]
    nil
