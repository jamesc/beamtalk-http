/// HTTPRequest — Sealed value class for incoming HTTP requests.
///
/// Represents an incoming HTTP request received by an `HTTPServer`.
/// HTTPRequest instances are immutable value objects created by the
/// server handler and passed to the user's handler block or object.
///
/// ## Fields
///
/// - `method`      — HTTP method as a String (e.g. "GET", "POST")
/// - `path`        — Request path as a String (e.g. "/api/users")
/// - `headers`     — Request headers as a List of [name, value] binary pairs
/// - `body`        — Request body: a String when valid UTF-8, otherwise a Binary (empty for GET/DELETE)
/// - `bodyBytes`   — The same body as raw bytes (a Binary): no UTF-8 check, so it
///                   skips the validation `body` pays on large bodies
/// - `queryParams` — Query parameters as a Dictionary
///
/// ## Examples
/// ```beamtalk
/// srv := HTTPServer start: 8080 handler: [:req |
///   req method       // => "GET"
///   req path         // => "/hello"
///   req headers      // => #(#("host", "localhost:8080"), ...)
///   req body         // => ""
///   req bodyBytes    // => the raw bytes, never validated
///   req queryParams  // => #{}
///   HTTPResponse new: #{ #status => 200, #body => "ok" }
/// ]
/// ```
sealed typed Value subclass: HTTPRequest
  /// HTTP method (e.g. "GET", "POST", "PUT", "DELETE").
  field: method :: String = ""
  /// Request path (e.g. "/api/users").
  field: path :: String = "/"
  /// Request headers as a List of [name, value] binary pairs.
  field: headers :: List(List(String)) = #()
  /// Request body: a String when the bytes are valid UTF-8, otherwise a Binary.
  ///
  /// An explicit method below replaces the generated getter: with a live
  /// exchange, in the connection process, reading `body` reads the rest
  /// of the request body; anywhere else (or with no exchange) it answers
  /// this buffered value.
  field: body :: String | Binary = ""
  /// Query parameters as a Dictionary.
  field: queryParams :: Dictionary(String, String) = #{}
  /// Path parameters extracted by HTTPRouter (e.g. `:id` → "42").
  field: params :: Dictionary(String, String) = #{}
  /// The Buccaneer `Exchange` this request arrived on (nil in hand-built
  /// requests). It is owner-bound: every operation that
  /// touches the connection works only in the connection process, and
  /// raises `#not_owner` anywhere else.
  field: exchange :: Exchange | Nil = nil

  /// The next part of the request body; an empty Binary means the end of
  /// the body. For block and router handlers, which run in the connection
  /// process: `HTTPHandler` actors already get the whole body, and using
  /// `readChunk` there raises `#not_owner`. Without an exchange (a
  /// hand-built request) there is nothing to stream, so this answers
  /// `Result error: #not_supported`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// total := 0
  /// done := false
  /// [done] whileFalse: [
  ///   chunk := (req readChunk) unwrap
  ///   chunk isEmpty ifTrue: [done := true] ifFalse: [total := total + chunk size]
  /// ]
  /// ```
  readChunk -> Result(Binary, Error) =>
    ex := self.exchange
    ex isNil ifTrue: [^Result error: #not_supported]
    part := ex readBody
    part isError ifTrue: [^part]
    Result ok: part value data

  /// The rest of the request body (Plug `read_body` semantics): whatever
  /// the handler has not already consumed with `readChunk`, bounded by
  /// `HttpExchangeAdapter maxBodyBytes` (answers 413 itself when the rest
  /// is larger, then raises — the adapter passes that raise through to
  /// the engine since the response has started). A String when the bytes
  /// are valid UTF-8, otherwise a Binary, as the buffered body is.
  ///
  /// This reads from the exchange only in the connection process. Anywhere
  /// else — an `HTTPHandler` actor, which gets the whole body read before
  /// it is called, or a request with no exchange — it answers the buffered
  /// body, so it never trips `#not_owner`.
  ///
  /// A buffered body set by construction (a Plug's `withBody:` copy) wins
  /// over the live stream: a transforming plug has already consumed the
  /// stream to build it, so re-reading would answer the drained remainder
  /// (or raise) instead of the transformed value downstream must see.
  body -> String | Binary =>
    ex := self.exchange
    ex isNil ifTrue: [^self.body]
    owned := Pid current =:= ex owner
    // self.body here is the stored field: this explicit method replaces
    // the generated getter.
    owned ifFalse: [^self.body]
    self.body isEmpty ifFalse: [^self.body]
    HttpExchangeAdapter bodyValue: (self liveBytes: ex)

  /// The request body as raw bytes: a Binary, with no UTF-8 check and no
  /// String retagging (BT-4500). Use it when the handler only forwards,
  /// stores or hashes the bytes (an echo, a binary upload): `body` must
  /// validate every byte to decide String or Binary, and this skips that
  /// cost entirely.
  ///
  /// It reads exactly as `body` does: lazily from the exchange in the
  /// connection process (bounded by `HttpExchangeAdapter maxBodyBytes`,
  /// 413 past it), and from the buffered field anywhere else. A buffered
  /// String body (a Plug's `withBody:` copy) answers that String's bytes.
  ///
  /// The read is shared with `body`: whichever is called first reads the
  /// socket and the other answers from the same bytes, so mixing them
  /// never reads twice.
  ///
  /// ## Examples
  /// ```beamtalk
  /// HTTPResponse new: #{ #status => 200, #body => req bodyBytes }
  /// ```
  bodyBytes -> Binary =>
    ex := self.exchange
    ex isNil ifTrue: [^self bufferedBytes]
    owned := Pid current =:= ex owner
    owned ifFalse: [^self bufferedBytes]
    self.body isEmpty ifFalse: [^self bufferedBytes]
    self liveBytes: ex

  /// The buffered body field as bytes. A String is a sealed Binary
  /// subclass over the same UTF-8 bytes, so it answers as is.
  bufferedBytes -> Binary => self.body

  /// The rest of the body from the live exchange, read at most once per
  /// request: the bytes are kept in the connection process's dictionary
  /// (an instance method, so it runs in the caller's process, and
  /// Buccaneer erases the key between keep-alive requests) so `body` and
  /// `bodyBytes` share one read.
  liveBytes: ex :: Exchange -> Binary =>
    key := {#http_request_body, ex ref}
    hit := (ProcessDictionary at: key) match: [
      b :: Binary -> b;
      _ -> nil
    ]
    hit isNil ifFalse: [^hit]
    read := ex readAll: HttpExchangeAdapter maxBodyBytes
    read isError
      ifTrue: [
        // The 413 goes out here, before raising: the adapter sees a
        // started exchange and passes the raise to the engine instead of
        // sending a second response. The message is free-form — nothing
        // matches on its text.
        read error =:= #body_too_large
          ifTrue: [
            HttpExchangeAdapter send413: ex
            Error signal: "request body exceeds the size limit"
          ]
        read error =:= #closed ifTrue: [
          TransportError signal: "client closed connection during body read"
        ]
        Error signal: ("Request body read failed: " ++ read error printString)
      ]
    ProcessDictionary at: key put: read value
    read value

  /// A 1xx informational response while the handler runs (`103 Early
  /// Hints`, ...). Answers `Result error: #not_supported` on HTTP/1.0 —
  /// and without an exchange (a hand-built request). From another process the
  /// exchange raises `#not_owner`.
  inform: status :: Integer headers: hs :: List(List(String)) -> Result(Nil, Object) =>
    ex := self.exchange
    ex isNil ifTrue: [^Result error: #not_supported]
    ex inform: status headers: (HttpExchangeAdapter responseHeaders: hs)

  /// Return the value of a named path parameter.
  ///
  /// Path parameters are populated by HTTPRouter when the request matches
  /// a parameterized route (e.g. `/users/:id`).
  ///
  /// ## Examples
  /// ```beamtalk
  /// req param: "id"   // => "42"
  /// ```
  param: name :: String -> String => self.params at: name

  /// Human-readable representation: "an HTTPRequest(GET /path)".
  /// The fields convert explicitly (BT-4172): a hand-built request may
  /// hold binaries, which still render as Strings this way.
  printString -> String =>
    "an HTTPRequest("
      ++ self.method asStringUnchecked
      ++ " "
      ++ self.path asStringUnchecked
      ++ ")"
