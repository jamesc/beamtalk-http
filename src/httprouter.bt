/// HTTPRouter — Compiled route dispatch for HTTPServer.
///
/// HTTPRouter is a sealed Value that holds a compiled route table. It is
/// created once (via `build:` or `routes:`) and then passed as the handler
/// to `HTTPServer start:handler:`. The router matches incoming requests
/// by method and path, extracts path parameters, and dispatches to the
/// appropriate handler block.
///
/// ## Builder API (preferred for multi-route apps)
/// ```beamtalk
/// router := HTTPRouter build: [:r |
///   r get: "/" handler: [:req | HTTPResponse new: #{ #status => 200, #body => "home" }].
///   r get: "/users/:id" handler: [:req |
///     id := req param: "id"
///     HTTPResponse new: #{ #status => 200, #body => "User " ++ id }
///   ].
///   r post: "/users" handler: [:req | HTTPResponse new: #{ #status => 201, #body => "created" }]
/// ]
/// srv := HTTPServer start: 8080 handler: router
/// ```
///
/// ## Route list API
/// ```beamtalk
/// router := HTTPRouter routes: #(
///   HTTPRoute get: "/" handler: [:req | HTTPResponse new: #{ #status => 200, #body => "home" }],
///   HTTPRoute get: "/users/:id" handler: [:req |
///     HTTPResponse new: #{ #status => 200, #body => (req param: "id") }
///   ]
/// )
/// ```
///
/// ## Path parameters
///
/// Path segments prefixed with `:` capture that segment as a named parameter:
///
/// ```beamtalk
/// r get: "/users/:id/posts/:postId" handler: [:req |
///   id := req param: "id"
///   postId := req param: "postId"
///   // ...
/// ]
/// ```
///
/// ## Wildcards
///
/// A segment prefixed with `*` captures all remaining path segments:
///
/// ```beamtalk
/// r get: "/static/*path" handler: [:req |
///   filePath := req param: "path"   // => "css/main.css"
/// ]
/// ```
///
/// ## A note on `self` inside route handler blocks
///
/// Route handler blocks are invoked outside the owning actor's process
/// (see `HTTPServer`'s `HTTPHandlerLike` doc for the full explanation).
/// Any `self.field` a handler block closes over reflects a snapshot taken
/// when the block/route table was built — it is never re-read, even if
/// the actor's real state changes afterward. This means dependencies
/// attached to the actor *after* `buildRouter:`/`startServer:` has already
/// run will silently never be visible inside a handler. If a route needs
/// live actor state, or state that can change after startup, back it with
/// an actor implementing `HTTPHandler>>handle:` instead of a route block.
sealed typed Value subclass: HTTPRouter
  /// Compiled route table: `{method, segments, handler}` tuples (internal).
  field: compiledRoutes :: List(Tuple) = #()
  /// Custom not-found handler (internal).
  field: notFoundHandler :: Block(HTTPRequest, HTTPResponse) | Nil = nil
  /// Number of routes in this router.
  field: routeCount :: Integer = 0

  /// Build a router using a builder block.
  ///
  /// The block receives an `HTTPRouteBuilder` with methods like
  /// `get:handler:`, `post:handler:`, etc.
  ///
  /// ## Examples
  /// ```beamtalk
  /// router := HTTPRouter build: [:r |
  ///   r get: "/" handler: [:req | HTTPResponse new: #{ #status => 200, #body => "ok" }]
  /// ]
  /// ```
  class build: block :: Block(HTTPRouteBuilder, Object) -> HTTPRouter =>
    builder := HTTPRouteBuilder spawn
    block value: builder
    routeList := builder routes
    nfHandler := builder notFoundHandler
    builder stop
    self compileRoutes: routeList notFoundHandler: nfHandler

  /// Build a router from a List of HTTPRoute values.
  ///
  /// ## Examples
  /// ```beamtalk
  /// router := HTTPRouter routes: #(
  ///   HTTPRoute get: "/" handler: [:req | HTTPResponse new: #{ #status => 200, #body => "ok" }]
  /// )
  /// ```
  class routes: routeArray :: List(HTTPRoute) -> HTTPRouter =>
    self compileRoutes: routeArray notFoundHandler: nil

  /// Internal: compile a list of HTTPRoute values into a frozen router.
  ///
  /// Each route becomes a `{method, segments, handler}` tuple. A path
  /// pattern splits on `/` (empty parts dropped, so a trailing slash is
  /// ignored) into `{kind, text}` segments: `#literal` for an exact
  /// segment, `#param` for `:name` and `#wildcard` for `*name`. Raises a
  /// `type_error` for a route that is not a String method, String path
  /// and block handler, for a wildcard that is not the last segment, and
  /// for a parameter name used twice in one pattern.
  class compileRoutes: routeArray :: List(HTTPRoute) notFoundHandler: notFoundHandler :: Block(HTTPRequest, HTTPResponse) | Nil -> HTTPRouter =>
    compiled := routeArray collect: [:route | self compileRoute: route]
    self
      new: #{
        #compiledRoutes => compiled,
        #notFoundHandler => notFoundHandler,
        #routeCount => routeArray size
      }

  /// One `HTTPRoute` to its `{method, segments, handler}` tuple.
  class compileRoute: route :: Object -> Tuple =>
    (route isKindOf: HTTPRoute) ifFalse: [
      self badRoute: "Each route must be an HTTPRoute"
    ]
    method := route method
    path := route path
    handler := route handler
    ((method isKindOf: String) and: [
      (path isKindOf: String) and: [handler isKindOf: Block]
    ]) ifFalse: [self badRoute: "Each route must be [Method, Path, Handler]"]
    segments := (self splitPath: path) collect: [:part |
      self parseSegment: part
    ]
    self validate: segments pattern: path
    {method, segments, handler}

  /// A pattern segment to `{kind, text}`: `:name` is a `#param`, `*name`
  /// a `#wildcard` (a bare `:` or `*` stays literal), anything else a
  /// `#literal`.
  class parseSegment: part :: String -> Tuple(Symbol, String) =>
    (part size > 1 and: [
      part startsWith: ":"
    ]) ifTrue: [^{#param, part drop: 1}]
    (part size > 1 and: [
      part startsWith: "*"
    ]) ifTrue: [^{#wildcard, part drop: 1}]
    {#literal, part}

  /// Reject a wildcard before the last segment and a parameter name used
  /// twice in one pattern.
  class validate: segments :: List(Tuple(Symbol, String)) pattern: path :: String -> Nil =>
    names := #()
    last := segments size
    i := 0
    segments
      do: [:seg |
        i := i + 1
        {kind, text} := seg
        (kind =:= #wildcard and: [
          i < last
        ]) ifTrue: [
          self badRoute: "Wildcard must be the last segment in pattern: " ++ path
        ]
        kind =:= #literal
          ifFalse: [
            (names includes: text) ifTrue: [
              self badRoute: "Duplicate parameter names in pattern: " ++ path
            ]
            names := names add: text
          ]
      ]
    nil

  class badRoute: hint :: String -> Never =>
    Exception
      signalKind: #type_error
      class: #HTTPRouter
      selector: #compile:
      hint: hint

  /// A URL path to its segments, dropping empty parts (`"/a//b/"` is
  /// `#("a", "b")`). Segments stay raw: no percent-decoding.
  class splitPath: path :: String -> List(String) =>
    (path split: "/") reject: [:part | part isEmpty]

  /// The parameters `pattern` captures from `segs`, or nil when it does
  /// not match.
  class match: pattern :: List(Tuple(Symbol, String)) segments: segs :: List(String) -> Dictionary(String, String) | Nil =>
    params := #{}
    rest := segs
    pattern
      do: [:seg |
        rest isEmpty ifTrue: [^nil]
        {kind, text} := seg
        kind =:= #wildcard ifTrue: [^params at: text put: (rest join: "/")]
        current := rest first
        kind =:= #param ifTrue: [
          params := params at: text put: current
        ] ifFalse: [current =:= text ifFalse: [^nil]]
        rest := rest rest
      ]
    rest isEmpty ifTrue: [params] ifFalse: [nil]

  /// Match a method and path against this router's compiled routes.
  ///
  /// Answers `{#ok, handler, params}` for the first route whose pattern
  /// and method both match, `#method_not_allowed` when some pattern
  /// matched but no route with that method did, and `#not_found`
  /// otherwise. `params` maps each `:name` / `*name` to its raw
  /// segment (a wildcard joins what it took with `/`, and needs at
  /// least one segment).
  ///
  /// ## Examples
  /// ```beamtalk
  /// router match: "GET" path: "/users/42"   // => {#ok, aBlock, #{"id" => "42"}}
  /// router match: "POST" path: "/users/42"  // => #method_not_allowed
  /// ```
  match: method :: String path: path :: String -> Object =>
    segs := HTTPRouter splitPath: path
    pathMatched := false
    self.compiledRoutes
      do: [:route |
        {routeMethod, pattern, h} := route
        params := HTTPRouter match: pattern segments: segs
        params isNil
          ifFalse: [
            routeMethod =:= method ifTrue: [^{#ok, h, params}]
            pathMatched := true
          ]
      ]
    pathMatched ifTrue: [#method_not_allowed] ifFalse: [#not_found]

  /// Human-readable representation: "an HTTPRouter(6 routes)".
  printString -> String =>
    "an HTTPRouter(" ++ self.routeCount printString ++ " routes)"
