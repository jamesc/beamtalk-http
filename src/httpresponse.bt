/// HTTPResponse — Sealed value class for HTTP response objects.
///
/// Represents the result of an HTTP request: status code, headers, and body.
/// HTTPResponse instances are returned by `HTTPClient` class methods and are
/// immutable value objects (no actor process).
///
/// ## Fields
///
/// - `status`  — HTTP status code (integer, e.g. 200, 404, 500)
/// - `headers` — Response headers as a List of [name, value] binary pairs
/// - `body`    — Response body: a String when valid UTF-8, otherwise a Binary
///
/// ## Examples
/// ```beamtalk
/// resp := (HTTPClient get: "https://httpbin.org/get") unwrap
/// resp status      // => 200
/// resp headers     // => #(#("content-type", "application/json"), ...)
/// resp body        // => "{...}"
/// resp ok          // => true
/// resp bodyAsJson  // => Result ok: a Dictionary
/// ```
sealed typed Value subclass: HTTPResponse
  /// HTTP status code (e.g. 200, 404, 500).
  field: status :: Integer = 0
  /// Response headers as a List of [name, value] binary pairs.
  field: headers :: List(List(String | Binary)) = #()
  /// Response body: a String when the bytes are valid UTF-8, otherwise a Binary.
  field: body :: String | Binary = ""
  /// A streaming response: the block the adapter runs in the connection
  /// process with an `HttpChunkWriter`. Set only by `streamWith:`; when
  /// set, `status`/`headers`/`body` are ignored and the block's
  /// `startChunked:headers:` sets them instead.
  field: stream :: Block(HttpChunkWriter, Object) | Nil = nil
  /// A file response: the path sent with the engine's sendfile. Set only
  /// by `file:` / `file:offset:length:`; `status` and `headers` are set as
  /// on any `HTTPResponse`, `body` is ignored.
  field: file :: String | Nil = nil
  /// First byte sent by a file response.
  field: fileOffset :: Integer = 0
  /// Bytes sent by a file response, or `#all` for the rest of the file.
  field: fileLength :: Integer | Symbol = #all
  /// A WebSocket upgrade: the handler class the adapter runs the
  /// connection through. Set only by `upgradeWebSocket:`; when set,
  /// `status`/`headers`/`body`/`stream`/`file` are ignored and the
  /// engine sends 101 and hands the connection over after the
  /// handler answers.
  field: websocketHandler :: Object | Nil = nil

  /// A chunked response: the adapter runs `block` in the connection
  /// process with an `HttpChunkWriter`, so this works the same for block,
  /// router and `HTTPHandler` actor handlers. The block starts the
  /// response, sends chunks and finishes it:
  ///
  /// ## Examples
  /// ```beamtalk
  /// HTTPResponse streamWith: [:resp |
  ///   resp startChunked: 200 headers: #(#("content-type", "text/plain"))
  ///   resp sendChunk: "part 1"
  ///   resp sendChunk: "part 2"
  ///   resp finish]
  /// ```
  ///
  /// If the block returns without `finish`, the adapter finishes the
  /// response; if it never calls `startChunked:headers:`, the request is
  /// a 500. A raise after the headers went out closes the connection.
  class streamWith: block :: Block(HttpChunkWriter, Object) -> HTTPResponse =>
    self new: #{#stream => block}

  /// The whole file at `path` as the response body, sent with the
  /// engine's sendfile (a read-and-send loop over TLS). Set `status` and
  /// `headers` as on any `HTTPResponse`:
  ///
  /// ## Examples
  /// ```beamtalk
  /// (HTTPResponse file: "test/fixtures/stream_file")
  ///   withStatus: 200
  /// ```
  class file: path :: String -> HTTPResponse =>
    self
      file: path
      offset: 0
      length: #all

  /// `length` bytes at `offset` as the response body, or the rest of the
  /// file with `#all`.
  class file: path :: String offset: offset :: Integer length: length :: Integer | Symbol -> HTTPResponse =>
    self new: #{#file => path, #fileOffset => offset, #fileLength => length}

  /// Upgrade the connection to WebSocket through `handlerClass`, a
  /// `WebSocketHandler` Value class. The adapter answers 101 and runs
  /// the connection through it; any handler — block, router or
  /// `HTTPHandler` actor — may answer this:
  ///
  /// ## Arguments
  /// - `handlerClass` (Object) — the `WebSocketHandler` class. Its
  ///   `onOpen:request:` answers the first handler state; `onText:`,
  ///   `onBinary:` and the optional `onInfo:` answer the next.
  ///
  /// ## Examples
  /// ```beamtalk
  /// HTTPServer start: 8080 handler: [:req |
  ///   HTTPResponse upgradeWebSocket: EchoHandler]
  /// ```
  class upgradeWebSocket: handlerClass :: Object -> HTTPResponse =>
    self new: #{#websocketHandler => handlerClass}

  /// True if the status code is in the 2xx success range.
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp ok   // => true   (for status 200)
  /// resp ok   // => false  (for status 404)
  /// ```
  sealed ok -> Boolean => (self.status >= 200) and: [self.status <= 299]

  /// Parse the response body as JSON.
  ///
  /// Returns `Result ok:` with the parsed value (typically a Dictionary),
  /// or `Result error:` if the body is not valid JSON or is a non-UTF-8
  /// Binary.
  ///
  /// ## Examples
  /// ```beamtalk
  /// json := resp bodyAsJson unwrap   // => a Dictionary or List
  /// ```
  sealed bodyAsJson -> Result(JsonValue, Error) =>
    (self.body isKindOf: String) ifTrue: [
      Json parse: self.body
    ] ifFalse: [
      [
        Error signal: "body is not UTF-8 text"
      ] on: Error do: [:e | Result error: e]
    ]

  /// Human-readable representation: "an HTTPResponse(200)".
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp printString   // => "an HTTPResponse(200)"
  /// ```
  printString -> String => "an HTTPResponse(" ++ self.status printString ++ ")"
