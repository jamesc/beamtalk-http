/// The options `request:url:options:` and `request:path:options:` accept:
/// Symbol keys with values checked at each use site. See the class-side
/// `request:url:options:` for one bullet per key.
type RequestOptions = Dictionary(Symbol, Dynamic)

/// The `spawnWith:` config for a persistent client: Symbol keys with
/// values checked at each use site. See `## Options` below for one bullet
/// per key.
type ClientOptions = Dictionary(Symbol, Dynamic)

/// A live Mint connection the client threads through a request: HTTP/1.1
/// or (over TLS with `h2` negotiated) HTTP/2.
type HTTPClientConn = MintHTTP1 | MintHTTP2

/// What `transact:method:url:options:` answers: the connection to reuse
/// or close (nil after a transport failure) and the request's Result.
type HTTPClientOutcome = Tuple(HTTPClientConn | Nil, Result(HTTPResponse, Exception))

/// HTTPClient — actor-based HTTP client for one-shot and persistent requests.
///
/// Requests run over Mint (BT-4530): `http` URLs go through `MintHTTP1`,
/// `https` URLs negotiate the protocol over TLS (`h2` served by
/// `MintHTTP2`, anything else by `MintHTTP1`) with the same peer
/// verification gun applied (system CA bundle, SNI, HTTPS hostname
/// check).
///
/// ## One-shot convenience methods (class-side)
///
/// ```beamtalk
/// resp := (HTTPClient get: "https://httpbin.org/get") unwrap
/// resp status     // => 200
///
/// resp := (HTTPClient post: "https://httpbin.org/post" body: "{}") unwrap
/// resp := (HTTPClient delete: "https://httpbin.org/delete") unwrap
/// ```
///
/// ## Persistent client (actor instance)
///
/// Spawn an actor with a base URL and optional headers/timeout. Instance
/// methods accept relative paths and prepend the base URL automatically.
/// The actor keeps its Mint connection across requests (reconnecting when
/// the server closed it), so consecutive requests reuse one connection.
///
/// ```beamtalk
/// client := HTTPClient spawnWith: #{
///   #baseUrl => "https://httpbin.org",
///   #headers => #(#("X-Custom", "value")),
///   #timeout => 10000
/// }
/// resp := (client get: "/get") unwrap
/// resp := (client post: "/post" body: "{}") unwrap
/// client stop
/// ```
///
/// ## Options
/// - `#baseUrl` (String, required) — prepended to every relative path.
/// - `#headers` (List of [name, value] pairs, default `#()`) — the actor defaults, replacing per request with `get:headers:` and friends.
/// - `#timeout` (Integer, default `30000`) — the actor defaults in milliseconds, replacing per request with `request:path:options:`.
///
/// @see HTTPServer (for serving HTTP requests)
/// @see HTTPResponse (for response objects returned by requests)
typed Actor subclass: HTTPClient
  state: baseUrl :: String = ""
  state: headers :: List(List(String)) = #()
  state: timeout :: Integer = 30000
  // Persistent Mint connection (a MintHTTP1 or MintHTTP2 value) reused
  // across instance requests, or nil. Mint connections are values, so
  // every request threads the stored one through and stores the updated
  // copy; a dead connection reconnects on the next request. The socket
  // is owned by this actor's process and closes on death, so no
  // terminate: hook is needed to release it.
  state: conn :: HTTPClientConn | Nil = nil

  // ===== Class-side one-shot convenience methods =====

  /// Perform a one-shot GET request (class method).
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (HTTPClient get: "https://httpbin.org/get") unwrap
  /// resp status   // => 200
  /// ```
  class get: url :: String -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #get
      url: url
      options: #{}

  /// Perform a one-shot GET request with headers (class method).
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (HTTPClient get: "https://httpbin.org/get" headers: #(#("X-Custom", "value"))) unwrap
  /// ```
  class get: url :: String headers: headers :: List(List(String)) -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #get
      url: url
      options: #{#headers => headers}

  /// Perform a one-shot POST request with body (class method).
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (HTTPClient post: "https://httpbin.org/post" body: "{}") unwrap
  /// resp ok   // => true
  /// ```
  class post: url :: String body: body :: String -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #post
      url: url
      options: #{#body => body}

  /// Perform a one-shot POST request with headers and body (class method).
  class post: url :: String headers: headers :: List(List(String)) body: body :: String -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #post
      url: url
      options: #{#headers => headers, #body => body}

  /// Perform a one-shot PUT request with body (class method).
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (HTTPClient put: "https://httpbin.org/put" body: "{}") unwrap
  /// resp ok   // => true
  /// ```
  class put: url :: String body: body :: String -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #put
      url: url
      options: #{#body => body}

  /// Perform a one-shot PUT request with headers and body (class method).
  class put: url :: String headers: headers :: List(List(String)) body: body :: String -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #put
      url: url
      options: #{#headers => headers, #body => body}

  /// Perform a one-shot DELETE request (class method).
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (HTTPClient delete: "https://httpbin.org/delete") unwrap
  /// resp ok   // => true
  /// ```
  class delete: url :: String -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #delete
      url: url
      options: #{}

  /// Perform a one-shot DELETE request with headers (class method).
  class delete: url :: String headers: headers :: List(List(String)) -> Result(HTTPResponse, Exception) =>
    self
      oneShot: #delete
      url: url
      options: #{#headers => headers}

  /// Perform a one-shot generic request (class method).
  ///
  /// ## Arguments
  /// - `method` (Symbol | String) — the HTTP method (`#patch` or `"PATCH"`).
  /// - `url` (String) — the full URL to request.
  /// - `opts` (RequestOptions) — the request options, one entry per key below.
  ///
  /// ## Options
  /// - `#headers` (List of [name, value] pairs, default `#()`) — request headers.
  /// - `#body` (String, default empty) — request body.
  /// - `#timeout` (Integer, default `30000`) — timeout in milliseconds.
  /// - `#maxBodyBytes` (Integer | `#unlimited`, default `unlimited`) — cap on the response body in bytes: larger bodies answer `Result error:` without being returned.
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := HTTPClient request: #patch url: "https://httpbin.org/patch"
  ///   options: #{#body => "{}", #timeout => 5000}
  /// ```
  class request: method :: Symbol | String url: url :: String options: opts :: RequestOptions -> Result(HTTPResponse, Exception) =>
    self
      oneShot: method
      url: url
      options: opts

  // ===== Connection core (class-side) =====

  /// The default request timeout in milliseconds.
  class defaultTimeout -> Integer => 30000

  /// One request over a fresh connection: connect, transact, close the
  /// connection, and answer the Result.
  class oneShot: method :: Symbol | String url: url :: String options: opts :: RequestOptions -> Result(HTTPResponse, Exception) =>
    done := self
      transact: nil
      method: method
      url: url
      options: opts
    conn := done at: 1
    conn isNil ifFalse: [conn close]
    done at: 2

  /// The full validated request cycle over `conn` (nil connects fresh).
  /// Answers `{connOrNil, Result}`: the live connection threading the
  /// request (for the caller to reuse or close), and `Result ok:` the
  /// built response or `Result error:` the failure. A transport failure
  /// closes the connection and answers nil for it — a failed stream
  /// leaves a Mint connection wedged (its in-flight reference stays
  /// set), so failed connections are never reused. Caller-side failures
  /// (an invalid URL, an over-cap body) keep a still-healthy connection:
  /// a bad URL sends nothing, and an over-cap body completed streaming
  /// without transport trouble — either way there is nothing to recover
  /// from, so no retry.
  class transact: conn :: HTTPClientConn | Nil method: method :: Symbol | String url: url :: String options: opts :: RequestOptions -> HTTPClientOutcome =>
    self checkOptions: opts
    upper := self normaliseMethod: method
    checkedUrl := self checkUrl: url
    headers := self checkHeaders: (opts at: #headers ifAbsent: [#()])
    body := self checkBody: (opts at: #body ifAbsent: [""])
    t := self checkTimeout: (opts at: #timeout ifAbsent: [self defaultTimeout])
    cap := self checkMaxBodyBytes: (opts at: #maxBodyBytes ifAbsent: [
      #unlimited
    ])
    start := self nowMs
    parsed := self urlParts: checkedUrl
    parsed isError ifTrue: [^{conn, Result error: parsed error}]
    info := parsed value
    live := conn
      ifNil: [
        made := self
          connect: info scheme
          host: info host
          port: info port
          timeout: (self remaining: t from: start)
        made isError ifTrue: [^{nil, Result error: made error}]
        made value
      ]
    lines := self headerLines: headers
    sent := live
      request: upper
      target: info path
      headers: lines
      body: body
    sent isError
      ifTrue: [
        live close
        ^{nil, self transportError: "Request failed" reason: sent error}
      ]
    // Mint's `request:...` answers `{conn, ref}`.
    {sentConn, ref} := sent value
    live2 := self connOf: sentConn
    got := live2 stream: ref timeout: (self remaining: t from: start)
    got isError
      ifTrue: [
        live2 close
        ^{nil, self transportError: "Request failed" reason: got error}
      ]
    // Mint's `stream:timeout:` answers `{conn, parts}`.
    {streamedConn, parts} := got value
    conn2 := self connOf: streamedConn
    built := self responseFrom: parts maxBodyBytes: cap
    built isError ifTrue: [^{conn2, built}]
    {conn2, built}

  /// Milliseconds left of the `t` budget at `start` (the shared request
  /// deadline: connect, request and stream all draw from it). Answers
  /// zero once the budget is spent.
  class remaining: t :: Integer from: start :: Integer -> Integer =>
    left := t - (self nowMs - start)
    left < 0 ifTrue: [^0]
    left

  /// Build an `HTTPResponse` from Mint response parts, enforcing the
  /// `maxBodyBytes` cap. Interim (`1xx`) responses are skipped by keeping
  /// the last status/headers seen; `#data` bytes are concatenated from
  /// every data part. The body answers a String when it is valid UTF-8,
  /// else a Binary (tagged via `Binary>>asString`, straight from the
  /// stdlib — no native helper).
  class responseFrom: parts :: List(Tuple) maxBodyBytes: cap :: Integer | Symbol -> Result(HTTPResponse, Exception) =>
    status :: Integer | Nil := nil
    pairs :: List(List(String | Binary)) := #()
    body := Binary fromBytes: #()
    parts
      do: [:part |
        // Mint parts: `{#status, ref, code}`, `{#headers, ref,
        // headers}`, `{#data, ref, bytes}` and `{#done, ref}`.
        tag := part at: 1
        known := ((tag =:= #status) or: [
          tag =:= #headers
        ]) or: [(tag =:= #data) or: [tag =:= #done]]
        known ifFalse: [
          ^self httpError: "Request failed (unknown response part)"
        ]
        tag =:= #status ifTrue: [status := part at: 3]
        tag =:= #headers
          ifTrue: [
            headers := part at: 3
            pairs := headers collect: [:h | #(h name, h value)]
          ]
        tag =:= #data ifTrue: [body := body concat: (part at: 3)]
      ]
    status isNil ifTrue: [
      ^self httpError: "Request failed (no response status)"
    ]
    (cap isKindOf: Integer) ifTrue: [
      body size > cap ifTrue: [^self httpError: "Response body exceeded limit"]
    ]
    converted := body asString
    tagged := converted isError ifTrue: [body] ifFalse: [converted value]
    Result ok: (HTTPResponse new: #{
      #status => status,
      #headers => pairs,
      #body => tagged
    })

  // ===== Connect =====

  /// Connect for `scheme` (`"http"` or `"https"`). Answers `Result ok:`
  /// the Mint connection value, or `Result error:` the failure.
  class connect: scheme :: String host: host :: String port: port :: Integer timeout: ms :: Integer -> Result(HTTPClientConn, Exception) =>
    scheme =:= "https"
      ifTrue: [
        ^self
          connectTls: host
          port: port
          timeout: ms
      ]
    self
      connectPlain: host
      port: port
      timeout: ms

  /// Resolve a host to a connect address tuple: IP literals (v4 and v6)
  /// parse directly, DNS names try IPv4 then IPv6 (`MintHTTP1>>resolve:`
  /// only tries IPv4, so IPv6 literals and v6-only names need this).
  /// Both lookups draw from the `ms` budget (`inet:getaddr/3` — the
  /// `/2` form waits forever, which would wedge a persistent client
  /// past its `#timeout`). Answers `Result ok:` the tuple, or `Result
  /// error:` the failure.
  class resolveHost: host :: String timeout: ms :: Integer -> Result(Tuple, Exception) =>
    literal := MintHTTP1 bare: ((Erlang inet) parse_address: (host asCharlist))
    literal isOk ifTrue: [^Result ok: literal value]
    start := self nowMs
    v4 := MintHTTP1
      bare: ((Erlang inet)
        getaddr: (host asCharlist)
        with: #inet
        with: ms)
    v4 isOk ifTrue: [^Result ok: v4 value]
    left := ms - (self nowMs - start)
    left < 0 ifTrue: [left := 0]
    v6 := MintHTTP1
      bare: ((Erlang inet)
        getaddr: (host asCharlist)
        with: #inet6
        with: left)
    v6 isError ifTrue: [
      ^self transportError: "Could not open connection" reason: v6 error
    ]
    Result ok: v6 value

  /// Plain-TCP connect with literal-first resolution. Answers `Result
  /// ok:` the `MintHTTP1` connection value, or `Result error:` the failure.
  class connectPlain: host :: String port: port :: Integer timeout: ms :: Integer -> Result(HTTPClientConn, Exception) =>
    start := self nowMs
    ip := self resolveHost: host timeout: ms
    ip isError ifTrue: [^Result error: ip error]
    sock := MintTcpSocket
      connect: ip value
      port: port
      opts: #(#binary, {#packet, #raw}, {#active, false})
      timeout: (self remaining: ms from: start)
    sock isError ifTrue: [
      ^self transportError: "Could not open connection" reason: sock error
    ]
    Result
      ok: (MintHTTP1
        socket: sock value
        transport: #tcp
        host: (self headerHost: host)
        port: port
        buffer: ""
        timeout: ms
        nextRef: 0
        inFlightRef: nil
        inFlightMethod: "")

  /// The host as Mint should send it in the `host` header: IPv6 literals
  /// bracketed (`[::1]`, RFC 3986 — `MintHTTP1>>hostHeader` does not
  /// bracket, and the server rejects the bare form with a 400). The
  /// connection itself still resolves the bare host.
  class headerHost: host :: String -> String =>
    (host includesSubstring: ":") ifTrue: [^"[" ++ host ++ "]"]
    host

  /// Connect over TLS with gun's verification (BT-4530): `verify_peer`
  /// against the system CA bundle, SNI (omitted for IP literals), the
  /// HTTPS hostname check, and ALPN offering both `h2` and `http/1.1`.
  /// The negotiated protocol picks the connection: `h2` runs the
  /// `MintHTTP2` handshake, anything else (including no negotiation, a
  /// server without ALPN) wraps as `MintHTTP1`.
  class connectTls: host :: String port: port :: Integer timeout: ms :: Integer -> Result(HTTPClientConn, Exception) =>
    start := self nowMs
    started := MintHTTP1 bare: ((Erlang application) ensure_all_started: #ssl)
    started isError ifTrue: [
      ^self transportError: "Could not open connection" reason: started error
    ]
    ip := self resolveHost: host timeout: (self remaining: ms from: start)
    ip isError ifTrue: [^Result error: ip error]
    sock := MintTlsSocket
      connect: ip value
      port: port
      opts: (self tlsOptionsFor: host)
      timeout: (self remaining: ms from: start)
    sock isError ifTrue: [
      ^self transportError: "Could not open connection" reason: sock error
    ]
    neg := MintHTTP1 bare: ((Erlang ssl) negotiated_protocol: (sock value) handle)
    negotiated := neg isOk ifTrue: [neg value] ifFalse: [nil]
    negotiated =:= (Binary fromIolist: "h2")
      ifTrue: [
        ^self
          connectH2: (sock value)
          host: host
          port: port
          timeout: (self remaining: ms from: start)
      ]
    // Anything else (including no negotiation, a server without ALPN)
    // goes through `MintHTTP1 connectTlsOn:` (BT-4551), which answers
    // HTTP/1.1 or a mismatch error for a protocol we never offered —
    // never a misparse. It closes the socket itself on mismatch.
    built := MintHTTP1
      connectTlsOn: sock value
      host: (self headerHost: host)
      port: port
      options: #{#timeout => ms, #alpn => #("http/1.1")}
    built isError ifTrue: [
      ^self transportError: "Could not open connection" reason: built error
    ]
    Result ok: built value

  /// Wrap a negotiated-`h2` socket via `MintHTTP2>>connectTlsOn:`
  /// (BT-4551 — the hand-built value plus `open:` is that
  /// constructor's job now). Closes the socket and answers `Result
  /// error:` when the handshake fails.
  class connectH2: sock :: MintTlsSocket host: host :: String port: port :: Integer timeout: ms :: Integer -> Result(HTTPClientConn, Exception) =>
    opened := MintHTTP2
      connectTlsOn: sock
      host: (self headerHost: host)
      port: port
      options: #{#timeout => ms}
    opened isError
      ifTrue: [
        sock close
        ^self transportError: "Could not open connection" reason: opened error
      ]
    Result ok: opened value

  /// The TLS options for an `https` host: `verify_peer` against the
  /// system CA bundle, the HTTPS hostname check, SNI as a charlist
  /// (omitted for IP literals), and ALPN offering `h2` and
  /// `http/1.1` (BT-4551 — owned by the `Tls` builder,
  /// retiring the hand-rolled `cacerts_get`/match-fun/SNI assembly).
  class tlsOptionsFor: host :: String -> List(Object) =>
    Tls clientOptions: host alpn: #("h2", "http/1.1")

  /// Answer the live connection or nil, closing a dead one best effort.
  class liveConn: conn :: HTTPClientConn | Nil -> HTTPClientConn | Nil =>
    conn isNil ifTrue: [^nil]
    conn isOpen ifTrue: [^conn]
    conn close
    nil

  /// A Mint connection from one of Mint's `{conn, ...}` answers
  /// (`request:...`, `stream:timeout:`), checked: anything else raises.
  class connOf: conn :: Object -> HTTPClientConn =>
    conn match: [
      c1 :: MintHTTP1 -> c1;
      c2 :: MintHTTP2 -> c2;
      _ -> Error signal: "Mint answered no connection; got: " ++ conn printString
    ]

  // ===== Validation and parsing helpers =====

  /// Raise a `type_error` for a bad client argument.
  class typeError: sel :: Symbol hint: hint :: String -> Never =>
    Exception
      signalKind: #type_error
      class: #HTTPClient
      selector: sel
      hint: hint

  /// Answer a failed Result holding an `Error` value with `hint` (the
  /// value form of `Error signal:`, for transport failures that are
  /// ordinary Results, not raises).
  class httpError: hint :: String -> Result(Never, Exception) =>
    captured := Result tryDo: [Error signal: hint]
    Result error: captured error

  /// Answer a failed Result for a transport failure, appending the
  /// underlying reason to the hint as gun's errors did.
  class transportError: hint :: String reason: reason :: Object -> Result(Never, Exception) =>
    text := (reason isKindOf: String) ifTrue: [
      reason
    ] ifFalse: [reason printString]
    self httpError: (hint ++ " (" ++ text ++ ")")

  /// The request method as an uppercase String (`#get` or `"get"` to
  /// `"GET"`). Anything else raises a `type_error`, as does a method
  /// carrying CR or LF (it would split the request line like a
  /// smuggled header).
  class normaliseMethod: method :: Object -> String =>
    upper := (method isKindOf: Symbol)
      ifTrue: [(method asString) uppercase]
      ifFalse: [
        (method isKindOf: String)
          ifTrue: [method uppercase]
          ifFalse: [
            self typeError: #request:url:options: hint: "Method must be a Symbol or String"
          ]
      ]
    (self hasCrlf: upper) ifTrue: [
      self typeError: #request:url:options: hint: "Method must not contain CR or LF"
    ]
    upper

  /// Check the options value is a Dictionary holding only known request
  /// keys (`#headers`, `#body`, `#timeout`, `#maxBodyBytes`). Anything
  /// else — including a misspelled key that would otherwise silently
  /// fall back to its default — raises a `type_error`. Answers nil.
  class checkOptions: opts :: Object -> Nil =>
    (opts isKindOf: Dictionary) ifFalse: [
      self typeError: #request:url:options: hint: "Options must be a Dictionary"
    ]
    known := #(#headers, #body, #timeout, #maxBodyBytes)
    bad := (opts keys) reject: [:key | known includes: key]
    bad isEmpty
      ifFalse: [
        self typeError: #request:url:options: hint: ("Unknown request options; got: " ++ bad printString)
      ]
    nil

  /// Check a URL (or base URL / path part) is a String. Answers it.
  class checkUrl: url :: Object -> String =>
    (url isKindOf: String) ifFalse: [
      self typeError: #request:url:options: hint: "Url must be a String"
    ]
    url

  /// Check request headers are a List. Answers them.
  class checkHeaders: headers :: Object -> List(Object) =>
    (headers isKindOf: List) ifFalse: [
      self typeError: #request:url:options: hint: "Options.headers must be a List"
    ]
    headers

  /// Check a request body is a String. Answers it.
  class checkBody: body :: Object -> String =>
    (body isKindOf: String) ifFalse: [
      self typeError: #request:url:options: hint: "Options.body must be a String"
    ]
    body

  /// Check a timeout is a non-negative Integer of milliseconds. Answers it.
  class checkTimeout: t :: Object -> Integer =>
    (t isKindOf: Integer) ifFalse: [self badTimeout]
    t >= 0 ifFalse: [self badTimeout]
    t

  /// Raise the `checkTimeout:` `type_error`.
  class badTimeout -> Never =>
    self typeError: #request:url:options: hint: "Options.timeout must be a non-negative Integer"

  /// Check the `maxBodyBytes` cap is `#unlimited` or a non-negative
  /// Integer. Answers it.
  class checkMaxBodyBytes: cap :: Object -> Integer | Symbol =>
    (cap =:= #unlimited) ifTrue: [^#unlimited]
    (cap isKindOf: Integer) ifFalse: [self badMaxBodyBytes]
    cap >= 0 ifFalse: [self badMaxBodyBytes]
    cap

  /// Raise the `checkMaxBodyBytes:` `type_error`.
  class badMaxBodyBytes -> Never =>
    self typeError: #request:url:options: hint: "Options.maxBodyBytes must be unlimited or a non-negative Integer"

  /// Render header pairs as `"name: value"` lines for Mint. Each pair is
  /// a two-element List (or Tuple) of Strings (or Binaries, rendered
  /// unchecked as Mint does); anything else raises a `type_error`.
  /// Names and values must not contain CR or LF bytes: Mint splices
  /// lines verbatim, so a smuggled CRLF would split the request.
  class headerLines: headers :: List(Object) -> List(String) =>
    headers
      collect: [:pair |
        fields := self headerFields: pair
        name := self headerField: (fields at: 1) of: pair
        value := self headerField: (fields at: 2) of: pair
        (self hasCrlf: name)
          ifTrue: [
            self typeError: #request:url:options: hint: "Header names must not contain CR or LF"
          ]
        (self hasCrlf: value)
          ifTrue: [
            self typeError: #request:url:options: hint: "Header values must not contain CR or LF"
          ]
        (self headerText: name) ++ ": " ++ (self headerText: value)
      ]

  /// A header pair's two elements: `pair` must be a two-element List
  /// or Tuple, else this raises a `type_error`.
  class headerFields: pair :: Object -> List(Object) =>
    fields := pair match: [
      l :: List -> l;
      t :: Tuple -> t asList;
      _ -> self badHeaderPair: pair
    ]
    fields size =:= 2 ifFalse: [self badHeaderPair: pair]
    fields

  /// A header name or value: a String or Binary, else this raises a
  /// `type_error` naming the whole `pair`. One `isKindOf: Binary` test
  /// covers both, since `String` is a `Binary` subclass.
  class headerField: field :: Object of: pair :: Object -> Binary =>
    (field isKindOf: Binary) ifFalse: [self badHeaderPair: pair]
    field

  /// Raise the `headerLines:` `type_error` for a malformed `pair`.
  class badHeaderPair: pair :: Object -> Never =>
    self typeError: #request:url:options: hint: ("Headers must be a List of [Name, Value] pairs; got: " ++ pair printString)

  /// Whether text carries a CR or LF byte (13 or 10).
  class hasCrlf: text :: Binary -> Boolean =>
    bytes := text toBytes
    (bytes includes: 13) or: [bytes includes: 10]

  /// A header name or value as text (mirroring `MintHTTP1>>headerText:`,
  /// which is instance-side): Strings stay, Binaries decode unchecked,
  /// anything else renders empty.
  class headerText: value :: Object -> String =>
    (value isKindOf: String) ifTrue: [^value]
    (value isKindOf: Binary) ifTrue: [^value asStringUnchecked]
    ""

  /// Parse a URL into connection parts. Answers `Result ok:` a
  /// Dictionary with `#scheme` (String), `#host` (String), `#port`
  /// (Integer, defaulting to 80/443) and `#path` (String, defaulting to
  /// `"/"`, query preserved) — or `Result error:` for anything that is
  /// not an `http(s)` URL with a host.
  class parseUrl: url :: Object -> Result(Dictionary(Symbol, Object), Exception) =>
    parts := self urlParts: url
    parts isError ifTrue: [^Result error: parts error]
    Result ok: parts value asDictionary

  /// `parseUrl:` as a typed `HTTPClientUrl`: the parts the client
  /// connects with, or `Result error:` for anything that is not an
  /// `http(s)` URL with a host.
  class urlParts: url :: Object -> Result(HTTPClientUrl, Exception) =>
    (url isKindOf: String) ifFalse: [^self httpError: "Invalid URL"]
    raw := (Erlang uri_string) parse: url
    (raw isKindOf: Dictionary) ifFalse: [^self httpError: "Invalid URL"]
    // Wire values arrive as Binaries (BT-4173); text parts become
    // Strings here so scheme/host/path compare and concatenate below.
    scheme := self textOf: (raw at: #scheme ifAbsent: [
      ^self httpError: "Invalid URL"
    ])
    scheme isNil ifTrue: [^self httpError: "Invalid URL"]
    ((scheme =:= "http") or: [
      scheme =:= "https"
    ]) ifFalse: [^self httpError: "Invalid URL"]
    host := self textOf: (raw at: #host ifAbsent: [
      ^self httpError: "Invalid URL"
    ])
    host isNil ifTrue: [^self httpError: "Invalid URL"]
    host isEmpty ifTrue: [^self httpError: "Invalid URL"]
    port := raw at: #port ifAbsent: [
      scheme =:= "https" ifTrue: [443] ifFalse: [80]
    ]
    // `uri_string` answers an Integer port; anything else is no URL.
    (port isKindOf: Integer) ifFalse: [^self httpError: "Invalid URL"]
    path := self textOf: (raw at: #path ifAbsent: [""])
    path isNil ifTrue: [^self httpError: "Invalid URL"]
    path isEmpty ifTrue: [path := "/"]
    query := raw at: #query ifAbsent: [nil]
    query isNil
      ifFalse: [
        text := self textOf: query
        text isNil ifTrue: [^self httpError: "Invalid URL"]
        path := path ++ "?" ++ text
      ]
    Result
      ok: (HTTPClientUrl
        scheme: scheme
        host: host
        port: port
        path: path)

  /// Wire bytes as text: a String stays itself, a Binary decodes when it
  /// is valid UTF-8, anything else answers nil (the caller reports an
  /// invalid URL rather than corrupting the request). Mirrors
  /// `MintHTTP1>>stringOrOpaque`'s three shapes (bare String, Result,
  /// other) so an `asString` return-shape change breaks loudly here
  /// instead of misreading every URL.
  class textOf: bin :: Object -> String | Nil =>
    (bin isKindOf: String) ifTrue: [^bin]
    (bin isKindOf: Binary) ifFalse: [^nil]
    bin asString match: [
      s :: String -> s;
      r :: Result -> r isOk ifTrue: [r value] ifFalse: [nil];
      _ -> nil
    ]

  /// Milliseconds on the monotonic clock, for request deadlines.
  /// Monotonic, not wall-clock: `Time nowMs` (`system_time`) must NOT
  /// be substituted here — it jumps with NTP and would break deadlines.
  class nowMs -> Integer => Time monotonic: #millisecond

  /// Whether an HTTP method is safe to retry (RFC 9110 idempotent
  /// methods). Answers false for anything else, including unparsable
  /// methods (which fail validation before any retry decision).
  class idempotent: method :: Object -> Boolean =>
    upper := self normaliseMethod: method
    #("GET", "HEAD", "OPTIONS", "TRACE", "DELETE", "PUT") includes: upper

  // ===== Instance methods (persistent-client style) =====
  //
  // Actor state: baseUrl (String), headers (List), timeout (Integer),
  // conn (Mint connection value or nil).
  // Initialised via spawnWith: #{#baseUrl => "...", #headers => #(), #timeout => 30000}

  /// Perform a GET request using the stored base URL and default options.
  ///
  /// ## Examples
  /// ```beamtalk
  /// client := HTTPClient spawnWith: #{#baseUrl => "https://httpbin.org"}
  /// resp := (client get: "/get") unwrap
  /// resp ok   // => true
  /// ```
  get: path :: String -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #get
      url: url
      options: #{#headers => self.headers, #timeout => self.timeout}

  /// Perform a GET request with explicit headers, replacing the actor
  /// defaults for this request (as `#headers` in `request:path:options:`).
  get: path :: String headers: headers :: List(List(String)) -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #get
      url: url
      options: #{#headers => headers, #timeout => self.timeout}

  /// Perform a POST request using the stored base URL and default options.
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (client post: "/post" body: "{}") unwrap
  /// resp ok   // => true
  /// ```
  post: path :: String body: body :: String -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #post
      url: url
      options: #{
        #headers => self.headers,
        #timeout => self.timeout,
        #body => body
      }

  /// Perform a POST request with explicit headers (replacing the actor
  /// defaults) and body.
  post: path :: String headers: headers :: List(List(String)) body: body :: String -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #post
      url: url
      options: #{#headers => headers, #timeout => self.timeout, #body => body}

  /// Perform a PUT request using the stored base URL and default options.
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (client put: "/put" body: "{}") unwrap
  /// resp ok   // => true
  /// ```
  put: path :: String body: body :: String -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #put
      url: url
      options: #{
        #headers => self.headers,
        #timeout => self.timeout,
        #body => body
      }

  /// Perform a PUT request with explicit headers (replacing the actor
  /// defaults) and body.
  put: path :: String headers: headers :: List(List(String)) body: body :: String -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #put
      url: url
      options: #{#headers => headers, #timeout => self.timeout, #body => body}

  /// Perform a DELETE request using the stored base URL and default options.
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := (client delete: "/delete") unwrap
  /// resp ok   // => true
  /// ```
  delete: path :: String -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #delete
      url: url
      options: #{#headers => self.headers, #timeout => self.timeout}

  /// Perform a DELETE request with explicit headers, replacing the actor
  /// defaults for this request.
  delete: path :: String headers: headers :: List(List(String)) -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    self
      withConn: #delete
      url: url
      options: #{#headers => headers, #timeout => self.timeout}

  /// Perform a generic request using the stored base URL.
  ///
  /// ## Arguments
  /// - `method` (Symbol | String) — the HTTP method (`#patch` or `"PATCH"`).
  /// - `path` (String) — the relative path; the stored base URL is prepended.
  /// - `opts` (RequestOptions) — the request options, merged over the actor defaults (`#headers`, `#timeout`).
  ///
  /// ## Options
  /// The same request options as the class-side `request:url:options:`; see
  /// it for one bullet per key.
  ///
  /// ## Examples
  /// ```beamtalk
  /// resp := client request: #patch path: "/patch" options: #{#body => "{}"}
  /// resp ok   // => true
  /// ```
  request: method :: Symbol | String path: path :: String options: opts :: RequestOptions -> Result(HTTPResponse, Exception) =>
    url := (HTTPClient checkUrl: self.baseUrl) ++ (HTTPClient checkUrl: path)
    HTTPClient checkOptions: opts
    defaults := #{#headers => self.headers, #timeout => self.timeout}
    self
      withConn: method
      url: url
      options: (defaults merge: opts)

  /// Run one request over the persistent connection, reconnecting when the
  /// stored connection died. A reused connection that drops mid-request
  /// (a server-close raced the request) retries once over a fresh
  /// connection — but only for idempotent methods: resubmitting a POST
  /// or PATCH could apply the body twice. Answers the Result, storing
  /// the live connection (or nil) for the next request.
  withConn: method :: Symbol | String url: url :: String options: opts :: RequestOptions -> Result(HTTPResponse, Exception) =>
    start := HTTPClient nowMs
    live := HTTPClient liveConn: self.conn
    self.conn := live
    done := HTTPClient
      transact: live
      method: method
      url: url
      options: opts
    self.conn := done at: 1
    result := done at: 2
    result isOk ifTrue: [^result]
    // Retry only a genuinely reused connection that died on the wire:
    // transact answers nil for the connection on transport failures,
    // and keeps it on caller-side failures (bad URL, over-cap body).
    retryable := (live isNil not and: [
      (done at: 1) isNil
    ]) and: [HTTPClient idempotent: method]
    retryable ifFalse: [^result]
    // The retry draws from the same deadline: whatever the first
    // attempt spent is gone, so a retried request stays bounded by
    // the caller's `#timeout` instead of starting a fresh clock.
    t := HTTPClient checkTimeout: (opts at: #timeout ifAbsent: [self.timeout])
    retry := HTTPClient
      transact: nil
      method: method
      url: url
      options: (opts merge: #{
        #timeout => (HTTPClient remaining: t from: start)
      })
    self.conn := retry at: 1
    retry at: 2
